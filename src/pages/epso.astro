---
import EpsoPrepApp from '../components/EpsoPrepApp';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A calm, ADHD-friendly EPSO numerical reasoning practice web app." />
    <meta name="theme-color" content="#606c38" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="EPSO Prep" />
    <title>EPSO Prep</title>
    <link rel="manifest" href="/epso.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/epso-icon.svg" />
    <link rel="apple-touch-icon" href="/epso-icon.svg" />
  </head>
  <body>
    <EpsoPrepApp client:load />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/epso-service-worker.js'));
      }
    </script>
  </body>
</html>
