---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DocumentsFilter from '../components/DocumentsFilter.tsx';
import ClientPortalBlock from '../components/ClientPortalBlock.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { sectorCatalogDocuments, sectorCatalogMeta } from '../data/sectorCatalog';
import { t } from '../i18n/fr';

const documents = sectorCatalogDocuments;
---

<BaseLayout title={t.documents.title} description={t.documents.intro}>
  <div class="page-shell">
    <PageHero
      eyebrow="Catalogue sectoriel"
      title={`${documents.length.toLocaleString('fr-BE')} documents, une source claire.`}
      description="Recherchez les conditions générales, fiches IPID, informations commerciales et documents fiscaux publiés par les compagnies d’assurance."
      image="/images/photos/news-nouveau-site-documents.jpg"
      compact
    />

    <section class="document-browser" aria-label="Recherche de documents">
      <div class="document-browser__intro">
        <p class="organic-kicker">Bibliothèque produit</p>
        <h2>Retrouver le bon document sans fouiller chaque site.</h2>
        <p>Le résultat ouvre directement le PDF ou la page de la compagnie. BDT Sironval ne remplace pas la version publiée par l’assureur.</p>
      </div>
      <DocumentsFilter documents={documents} syncedAt={sectorCatalogMeta.syncedAt} client:load />
      <noscript><p>La recherche interactive nécessite JavaScript. Contactez-nous si vous souhaitez recevoir un document.</p></noscript>
    </section>

    <section class="portal-section"><ClientPortalBlock /></section>
  </div>

  <ContactCTA
    title="Un document introuvable ?"
    body="Dites-nous ce que vous cherchez : conditions générales, attestation ou formulaire. Nous vous aidons à retrouver la version utile."
  />
</BaseLayout>
