---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import PageHero from '../../components/PageHero.astro';

const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Actualités" description="Conseils, changements légaux et nouveautés du bureau : les actualités de BDT Sironval.">
  <div class="page-shell">
    <PageHero eyebrow="Infos pratiques" title="Ce qui change, expliqué simplement." description="Conseils pratiques, évolutions légales et nouvelles du bureau, sans jargon." image="/images/photos/news-indexation-primes.jpg" compact />

  <section class="home-news">
    <div class="organic-card-grid">
      {
        news.map((article) => (
          <NewsCard
            title={article.data.title}
            summary={article.data.summary}
            date={article.data.date}
            tags={article.data.tags}
            image={article.data.image}
            href={`/actualites/${article.id}`}
          />
        ))
      }
    </div>
  </section>
  </div>

  <ContactCTA />
</BaseLayout>
