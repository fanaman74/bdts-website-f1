---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { INSURERS, getForwardSettings, parseEmailList, saveForwardSettings } from '../../lib/insurers';
import { emailStatus } from '../../lib/email';

export const prerender = false;

// The middleware only lets the signed-in administrator through; this is a
// second check so the settings form never relies on routing alone.
const isAdmin = Boolean(Astro.locals.admin);

let errors: string[] = [];
let submitted: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  if (!isAdmin) return new Response('Accès réservé aux administrateurs.', { status: 403 });

  const form = await Astro.request.formData();
  const field = (name: string) => String(form.get(name) ?? '').trim().slice(0, 1000);

  submitted = {};
  const contacts: Record<string, string> = {};
  for (const insurer of INSURERS) {
    const value = field(`contact-${insurer.id}`);
    submitted[`contact-${insurer.id}`] = value;
    if (!value) continue;
    const parsed = parseEmailList(value);
    if (!parsed) errors.push(`Adresse invalide pour ${insurer.name}.`);
    else contacts[insurer.id] = parsed.join(', ');
  }

  const cc = field('cc');
  const replyTo = field('replyTo');
  submitted.cc = cc;
  submitted.replyTo = replyTo;
  const parsedCc = cc ? parseEmailList(cc) : [];
  const parsedReplyTo = replyTo ? parseEmailList(replyTo, 1) : [];
  if (!parsedCc) errors.push('Adresse en copie invalide.');
  if (!parsedReplyTo) errors.push('Adresse de réponse invalide (une seule adresse).');

  if (errors.length === 0) {
    await saveForwardSettings({ contacts, cc: parsedCc!.join(', '), replyTo: parsedReplyTo![0] ?? '' });
    return Astro.redirect('/admin/insurers?saved=1');
  }
}

const saved = Astro.url.searchParams.get('saved') === '1';
const settings = await getForwardSettings();
const mail = emailStatus();

const value = (name: string, stored: string) => (submitted ? (submitted[name] ?? '') : stored);
const inputClass =
  'w-full rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#e8e6e1] focus:border-[#d4a24c] focus:outline-none disabled:opacity-60';
---

<AdminLayout title="Assureurs" active="insurers">
  <h1 class="text-5xl leading-none font-semibold tracking-tight uppercase">
    <span class="mr-1 text-[#d4a24c]">/</span>Assureurs
  </h1>
  <p class="mt-3 max-w-2xl text-sm leading-6 text-[#8b908b]">
    L’adresse à laquelle chaque compagnie reçoit les déclarations de sinistre. Elle pré-remplit le bouton « Transmettre à
    l’assureur » sur chaque dossier ; le message reste modifiable avant l’envoi.
  </p>

  {saved && (
    <p class="mt-6 rounded-lg border border-[#2b5c40] bg-[#12241a] px-4 py-2 text-sm text-[#8fd0a8]">Adresses enregistrées.</p>
  )}
  {errors.length > 0 && (
    <ul class="mt-6 space-y-1 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-4 py-2 text-sm text-[#e08b7c]">
      {errors.map((error) => <li>{error}</li>)}
    </ul>
  )}
  {!mail.configured || !mail.from ? (
    <p class="mt-6 rounded-lg border border-[#5a4620] bg-[#241a0d] px-4 py-2 text-sm text-[#e0b568]">
      Aucun e-mail ne peut partir pour l’instant : {mail.problems.join(' ; ')}.
    </p>
  ) : null}

  <form method="post" class="mt-8 max-w-3xl space-y-6">
    <section class="rounded-xl border border-[#262a28] bg-[#111312] px-5 py-5">
      <h2 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">Adresse sinistres par compagnie</h2>
      <div class="mt-4 space-y-3">
        {INSURERS.map((insurer) => (
          <label class="grid gap-1.5 sm:grid-cols-[170px_minmax(0,1fr)] sm:items-center sm:gap-4">
            <span class="text-sm text-[#c8c6c0]">{insurer.name}</span>
            <input
              type="text"
              name={`contact-${insurer.id}`}
              value={value(`contact-${insurer.id}`, settings.contacts[insurer.id] ?? '')}
              placeholder="sinistres@compagnie.be"
              disabled={!isAdmin}
              class={inputClass}
            />
          </label>
        ))}
      </div>
      <p class="mt-4 text-[11px] leading-5 text-[#6d726d]">Plusieurs adresses : séparez-les par une virgule.</p>
    </section>

    <section class="rounded-xl border border-[#262a28] bg-[#111312] px-5 py-5">
      <h2 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">Pour chaque envoi</h2>
      <div class="mt-4 space-y-3">
        <label class="grid gap-1.5 sm:grid-cols-[170px_minmax(0,1fr)] sm:items-center sm:gap-4">
          <span class="text-sm text-[#c8c6c0]">Copie (cc)</span>
          <input type="text" name="cc" value={value('cc', settings.cc)} placeholder="bdts@bdts.be" disabled={!isAdmin} class={inputClass} />
        </label>
        <label class="grid gap-1.5 sm:grid-cols-[170px_minmax(0,1fr)] sm:items-center sm:gap-4">
          <span class="text-sm text-[#c8c6c0]">Répondre à</span>
          <input type="text" name="replyTo" value={value('replyTo', settings.replyTo)} placeholder="bdts@bdts.be" disabled={!isAdmin} class={inputClass} />
        </label>
      </div>
      <p class="mt-4 text-[11px] leading-5 text-[#6d726d]">
        Les e-mails partent depuis {mail.from ?? 'EMAIL_FROM'}. « Répondre à » fait arriver la réponse de l’assureur dans la
        boîte du bureau plutôt qu’à cette adresse d’envoi.
      </p>
    </section>

    {isAdmin ? (
      <button type="submit" class="rounded-lg bg-[#d4a24c] px-4 py-2 text-sm font-medium text-[#1a1408] transition-colors hover:bg-[#e0b162]">
        Enregistrer
      </button>
    ) : (
      <p class="text-xs text-[#8b908b]">La modification des adresses est réservée aux administrateurs.</p>
    )}
  </form>
</AdminLayout>
