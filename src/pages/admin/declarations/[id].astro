---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  DECLARATION_STATUSES,
  DECLARATION_STATUS_LABELS,
  INSURER_SOURCE_LABELS,
  declarationName,
  getDeclaration,
  listDeclarationForwards,
  setDeclarationInsurer,
  updateDeclarationStatus
} from '../../../lib/declarations';
import { declarationReference, declarationSections } from '../../../lib/declarationSummary';
import { declarationPdfFilename } from '../../../lib/declarationEmail';
import { matchInsurer, missingInfo } from '../../../lib/claimTriage';
import { buildForwardDraft, forwardDeclaration, type ForwardDraft } from '../../../lib/claimForward';
import { INSURERS, getForwardSettings, insurerName, isInsurerId } from '../../../lib/insurers';
import { emailStatus } from '../../../lib/email';

export const prerender = false;

const id = Astro.params.id ?? '';
const declaration = id ? await getDeclaration(id) : null;

// An unknown id (stale bookmark, deleted row) falls back to the list.
if (!declaration) return Astro.redirect('/admin/declarations');

const settings = await getForwardSettings();
// A claim saved before triage existed, or one nothing matched, gets a fresh look.
const suggestion = declaration.insurer ? null : await matchInsurer(declaration).catch(() => null);

let forwardError = '';
let submittedDraft: ForwardDraft | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  if (action === 'status') {
    await updateDeclarationStatus(declaration.id, String(form.get('status') ?? ''));
    return Astro.redirect(`/admin/declarations/${declaration.id}?updated=1`);
  }
  if (action === 'insurer') {
    const insurer = String(form.get('insurer') ?? '');
    await setDeclarationInsurer(declaration.id, isInsurerId(insurer) ? insurer : null, 'manual');
    return Astro.redirect(`/admin/declarations/${declaration.id}?insurer=1`);
  }
  if (action === 'forward') {
    const field = (name: string, max: number) => String(form.get(name) ?? '').slice(0, max);
    submittedDraft = {
      insurer: field('insurer', 60),
      to: field('to', 1000),
      cc: field('cc', 1000),
      subject: field('subject', 300),
      body: field('body', 20000)
    };
    if (!isInsurerId(submittedDraft.insurer)) {
      forwardError = 'Choisissez d’abord l’assureur du dossier.';
    } else {
      const result = await forwardDeclaration(declaration, submittedDraft, {
        replyTo: settings.replyTo,
        sentBy: Astro.locals.admin?.username ?? null,
        // Sending to the suggested insurer confirms the suggestion as it was found.
        insurerSource:
          suggestion?.insurer === submittedDraft.insurer ? suggestion.source : (declaration.insurerSource ?? 'manual')
      });
      if (result.ok) return Astro.redirect(`/admin/declarations/${declaration.id}?forwarded=1`);
      forwardError = result.error;
    }
  }
}

const updated = Astro.url.searchParams.get('updated') === '1';
const insurerSaved = Astro.url.searchParams.get('insurer') === '1';
const forwarded = Astro.url.searchParams.get('forwarded') === '1';

const currentInsurer = declaration.insurer ?? suggestion?.insurer ?? null;
const missing = missingInfo({ ...declaration, insurer: currentInsurer });
const forwards = await listDeclarationForwards(declaration.id);
const lastSent = forwards.find((entry) => entry.ok);
const draft = submittedDraft ?? (currentInsurer ? buildForwardDraft(declaration, currentInsurer, settings) : null);
const mail = emailStatus();
const canSend = mail.configured && Boolean(mail.from);
const reference = declarationReference(declaration.id);
const fieldClass =
  'w-full rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#e8e6e1] focus:border-[#d4a24c] focus:outline-none';

const stamp = (date: Date) =>
  new Intl.DateTimeFormat('fr-BE', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Brussels' }).format(date);

const sections = declarationSections(declaration);

/** Human-readable attachment size, matching the picker hint on the form. */
function fileSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} o`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} Ko`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} Mo`;
}
---

<AdminLayout title="Dossier sinistre" active="declarations">
  <a href="/admin/declarations" class="text-xs text-[#d4a24c] underline-offset-2 hover:underline">← Toutes les déclarations</a>

  <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-4xl leading-none font-semibold tracking-tight uppercase">
        <span class="mr-1 text-[#d4a24c]">/</span>{declarationName(declaration)}
      </h1>
      <p class="mt-3 text-sm text-[#8b908b]">
        Déclaration reçue le {stamp(new Date(declaration.createdAt))} · référence {declarationReference(declaration.id)}
      </p>
    </div>

    <form method="post" class="flex items-center gap-2">
      <input type="hidden" name="action" value="status" />
      <label class="text-xs text-[#7f857f] uppercase" for="declaration-status">Statut</label>
      <select
        id="declaration-status"
        name="status"
        class="rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-1.5 text-sm text-[#c8c6c0] focus:border-[#d4a24c] focus:outline-none"
      >
        {DECLARATION_STATUSES.map((option) => (
          <option value={option} selected={option === declaration.status}>{DECLARATION_STATUS_LABELS[option]}</option>
        ))}
      </select>
      <button type="submit" class="rounded-lg bg-[#d4a24c] px-4 py-1.5 text-sm font-medium text-[#1a1408] transition-colors hover:bg-[#e0b162]">
        Enregistrer
      </button>
    </form>
  </div>

  {updated && (
    <p class="mt-6 rounded-lg border border-[#2b5c40] bg-[#12241a] px-4 py-2 text-sm text-[#8fd0a8]">Statut mis à jour.</p>
  )}
  {insurerSaved && (
    <p class="mt-6 rounded-lg border border-[#2b5c40] bg-[#12241a] px-4 py-2 text-sm text-[#8fd0a8]">Assureur enregistré.</p>
  )}
  {forwarded && lastSent && (
    <p class="mt-6 rounded-lg border border-[#2b5c40] bg-[#12241a] px-4 py-2 text-sm text-[#8fd0a8]">
      Déclaration transmise à {insurerName(lastSent.insurer)} ({lastSent.to}).
    </p>
  )}

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-[#262a28] bg-[#111312] px-5 py-5">
      <h2 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">Assureur</h2>
      {declaration.insurer && (
        <p class="mt-3 text-sm text-[#e8e6e1]">
          {insurerName(declaration.insurer)}
          {declaration.insurerSource && <span class="text-[#8b908b]"> · {INSURER_SOURCE_LABELS[declaration.insurerSource]}</span>}
        </p>
      )}
      {!declaration.insurer && suggestion && (
        <p class="mt-3 text-sm text-[#e0b568]">
          Suggestion : {insurerName(suggestion.insurer)}
          <span class="text-[#8b908b]"> · {INSURER_SOURCE_LABELS[suggestion.source]}</span>
        </p>
      )}
      {!currentInsurer && (
        <p class="mt-3 text-sm text-[#8b908b]">
          Aucun assureur trouvé : ni dossier précédent sur ce n° de police ou ce client, ni compagnie nommée dans la déclaration.
        </p>
      )}
      <form method="post" class="mt-4 flex flex-wrap items-center gap-2">
        <input type="hidden" name="action" value="insurer" />
        <label class="sr-only" for="declaration-insurer">Assureur</label>
        <select
          id="declaration-insurer"
          name="insurer"
          class="rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-1.5 text-sm text-[#c8c6c0] focus:border-[#d4a24c] focus:outline-none"
        >
          <option value="" selected={!currentInsurer}>— Non identifié —</option>
          {INSURERS.map((insurer) => (
            <option value={insurer.id} selected={insurer.id === currentInsurer}>{insurer.name}</option>
          ))}
        </select>
        <button type="submit" class="rounded-lg border border-[#2a2f2d] px-3 py-1.5 text-sm text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]">
          {declaration.insurer ? 'Modifier' : 'Confirmer'}
        </button>
      </form>
    </section>

    <section class="rounded-xl border border-[#262a28] bg-[#111312] px-5 py-5">
      <h2 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">À compléter</h2>
      {missing.length === 0 && <p class="mt-3 text-sm text-[#8fd0a8]">Rien ne manque : le dossier peut être transmis.</p>}
      {missing.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {missing.map((item) => (
            <li
              class:list={[
                'rounded-full border px-2.5 py-0.5 text-xs',
                item.blocking ? 'border-[#5e2f28] bg-[#2a1614] text-[#e08b7c]' : 'border-[#5a4620] bg-[#241a0d] text-[#e0b568]'
              ]}
            >
              {item.label}
            </li>
          ))}
        </ul>
      )}
      {missing.some((item) => item.blocking) && (
        <p class="mt-3 text-[11px] leading-5 text-[#6d726d]">
          En rouge : ce que l’assureur demandera avant d’ouvrir un dossier. Pensez à le réclamer au client ({declaration.email}).
        </p>
      )}
    </section>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    {sections.map((section) => (
      <section class="rounded-xl border border-[#262a28] bg-[#111312] px-5 py-5">
        <h2 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">{section.title}</h2>
        {section.note && <p class="mt-3 text-sm text-[#6d726d]">{section.note}</p>}
        {section.rows.length > 0 && (
          <dl class="mt-4 space-y-2.5">
            {section.rows.map(([label, value]) => (
              <div class="grid gap-1 sm:grid-cols-[190px_minmax(0,1fr)] sm:gap-4">
                <dt class="text-xs text-[#7f857f]">{label}</dt>
                <dd class="text-sm whitespace-pre-line text-[#e8e6e1]">{value}</dd>
              </div>
            ))}
          </dl>
        )}
      </section>
    ))}
  </div>

  <section class="mt-6 rounded-xl border border-[#262a28] bg-[#111312] px-5 py-5">
    <h2 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">Pièces jointes</h2>
    {declaration.attachments.length === 0 && <p class="mt-3 text-sm text-[#6d726d]">Aucun fichier joint.</p>}
    {declaration.attachments.length > 0 && (
      <ul class="mt-4 space-y-2">
        {declaration.attachments.map((attachment) => (
          <li class="flex flex-wrap items-center gap-3 rounded-lg border border-[#212524] bg-[#141716] px-4 py-2.5">
            <a
              href={`/admin/declarations/attachment/${attachment.id}`}
              class="text-sm text-[#d4a24c] underline-offset-2 hover:underline"
            >
              {attachment.filename}
            </a>
            <span class="text-[11px] text-[#6d726d]">{fileSize(attachment.byteSize)} · {attachment.contentType}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="transmettre" class="mt-6 rounded-xl border border-[#262a28] bg-[#111312] px-5 py-5">
    <h2 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">Transmettre à l’assureur</h2>

    {!draft && (
      <p class="mt-3 text-sm text-[#8b908b]">Choisissez d’abord l’assureur du dossier ci-dessus pour préparer l’e-mail.</p>
    )}

    {draft && (
      <form method="post" class="mt-4 space-y-4" data-forward-form data-insurer-name={insurerName(draft.insurer)}>
        <input type="hidden" name="action" value="forward" />
        <input type="hidden" name="insurer" value={draft.insurer} />

        {forwardError && (
          <p class="rounded-lg border border-[#5e2f28] bg-[#2a1614] px-4 py-2 text-sm text-[#e08b7c]">{forwardError}</p>
        )}
        {!canSend && (
          <p class="rounded-lg border border-[#5a4620] bg-[#241a0d] px-4 py-2 text-sm text-[#e0b568]">
            L’envoi est impossible pour l’instant : {mail.problems.join(' ; ')}.
          </p>
        )}
        {lastSent && (
          <p class="rounded-lg border border-[#5a4620] bg-[#241a0d] px-4 py-2 text-sm text-[#e0b568]">
            Déjà transmis à {insurerName(lastSent.insurer)} le {stamp(new Date(lastSent.createdAt))}. Un nouvel envoi enverra
            un second e-mail.
          </p>
        )}
        {!draft.to && !submittedDraft && (
          <p class="text-sm text-[#e0b568]">
            Aucune adresse enregistrée pour {insurerName(draft.insurer)}. Saisissez-la ci-dessous ou ajoutez-la dans
            <a href="/admin/insurers" class="text-[#d4a24c] underline-offset-2 hover:underline">Assureurs</a>.
          </p>
        )}

        <label class="grid gap-1.5 sm:grid-cols-[110px_minmax(0,1fr)] sm:items-center sm:gap-4">
          <span class="text-xs text-[#7f857f]">À ({insurerName(draft.insurer)})</span>
          <input type="text" name="to" value={draft.to} required class={fieldClass} />
        </label>
        <label class="grid gap-1.5 sm:grid-cols-[110px_minmax(0,1fr)] sm:items-center sm:gap-4">
          <span class="text-xs text-[#7f857f]">Copie</span>
          <input type="text" name="cc" value={draft.cc} class={fieldClass} />
        </label>
        <label class="grid gap-1.5 sm:grid-cols-[110px_minmax(0,1fr)] sm:items-center sm:gap-4">
          <span class="text-xs text-[#7f857f]">Objet</span>
          <input type="text" name="subject" value={draft.subject} required maxlength="300" class={fieldClass} />
        </label>
        <label class="grid gap-1.5 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-4">
          <span class="text-xs text-[#7f857f] sm:pt-2">Message</span>
          <textarea name="body" rows="16" required class:list={[fieldClass, 'font-mono text-[13px] leading-6']}>{draft.body}</textarea>
        </label>

        <div class="grid gap-1.5 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-4">
          <span class="text-xs text-[#7f857f]">Pièces jointes</span>
          <ul class="space-y-1 text-sm">
            <li>
              <a href={`/admin/declarations/${declaration.id}/summary.pdf`} target="_blank" class="text-[#d4a24c] underline-offset-2 hover:underline">
                {declarationPdfFilename(reference)}
              </a>
              <span class="text-[11px] text-[#6d726d]"> · récapitulatif généré</span>
            </li>
            {declaration.attachments.map((attachment) => (
              <li>
                <a href={`/admin/declarations/attachment/${attachment.id}`} target="_blank" class="text-[#d4a24c] underline-offset-2 hover:underline">
                  {attachment.filename}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-wrap items-center gap-3 sm:pl-[126px]">
          <button
            type="submit"
            disabled={!canSend}
            class="rounded-lg bg-[#d4a24c] px-4 py-2 text-sm font-medium text-[#1a1408] transition-colors hover:bg-[#e0b162] disabled:cursor-not-allowed disabled:opacity-50"
          >
            {lastSent ? 'Renvoyer' : 'Envoyer'} à {insurerName(draft.insurer)}
          </button>
          <span class="text-[11px] text-[#6d726d]">
            Les réponses arrivent à {settings.replyTo || mail.from || 'l’adresse d’envoi'}.
            {declaration.status === 'new' && ' Le dossier passera « En cours ».'}
          </span>
        </div>
      </form>
    )}

    {forwards.length > 0 && (
      <div class="mt-6 border-t border-[#212524] pt-4">
        <h3 class="text-xs tracking-[.12em] text-[#7f857f] uppercase">Historique des envois</h3>
        <ul class="mt-3 space-y-2">
          {forwards.map((entry) => (
            <li class="rounded-lg border border-[#212524] bg-[#141716] px-4 py-2.5 text-sm">
              <p class:list={[entry.ok ? 'text-[#e8e6e1]' : 'text-[#e08b7c]']}>
                {stamp(new Date(entry.createdAt))} · {insurerName(entry.insurer)} · {entry.ok ? 'envoyé' : 'échec'}
                {entry.sentBy && <span class="text-[#8b908b]"> · par {entry.sentBy}</span>}
              </p>
              <p class="mt-0.5 text-[11px] text-[#6d726d]">
                À {entry.to}{entry.cc ? ` · cc ${entry.cc}` : ''} · {entry.attachmentNames.length} pièce(s) jointe(s)
              </p>
              {entry.error && <p class="mt-0.5 text-[11px] text-[#e08b7c]">{entry.error}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <script>
    // Sending reaches a third party and cannot be recalled: ask once more.
    document.querySelectorAll<HTMLFormElement>('form[data-forward-form]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        const to = (form.elements.namedItem('to') as HTMLInputElement | null)?.value ?? '';
        if (!window.confirm(`Envoyer la déclaration à ${form.dataset.insurerName} (${to}) ?`)) event.preventDefault();
      });
    });
  </script>

  <p class="mt-6 text-[11px] leading-5 text-[#6d726d]">
    Consentement à la politique de confidentialité enregistré le {stamp(new Date(declaration.consentedAt))}. Dernière mise à
    jour du dossier le {stamp(new Date(declaration.updatedAt))}.
  </p>
</AdminLayout>

