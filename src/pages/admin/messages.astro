---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { INQUIRY_STATUSES, inquiryCounts, listInquiries, updateInquiryStatus } from '../../lib/inquiries';

export const prerender = false;

const STATUS_PILL: Record<string, { label: string; dot: string; text: string; bg: string; border: string }> = {
  new: { label: 'Nouveau', dot: 'bg-[#e0b568]', text: 'text-[#e0b568]', bg: 'bg-[#241a0d]', border: 'border-[#5a4620]' },
  in_progress: { label: 'En cours', dot: 'bg-[#7fb7d6]', text: 'text-[#7fb7d6]', bg: 'bg-[#12222b]', border: 'border-[#275065]' },
  closed: { label: 'Clôturé', dot: 'bg-[#4ea678]', text: 'text-[#8fd0a8]', bg: 'bg-[#12241a]', border: 'border-[#2b5c40]' },
  spam: { label: 'Indésirable', dot: 'bg-[#d1695a]', text: 'text-[#e08b7c]', bg: 'bg-[#2a1614]', border: 'border-[#5e2f28]' }
};

const FORM_LABEL: Record<string, string> = { contact: 'Contact', devis: 'Devis', declaration: 'Sinistre' };
const FORM_PAGE: Record<string, string> = { contact: '/contact', devis: '/devis', declaration: '/declaration' };
const FORM_OPTIONS = ['contact', 'devis', 'declaration'];

const params = Astro.url.searchParams;
let status = params.get('status') ?? '';
let formType = params.get('type') ?? '';
const search = params.get('q')?.trim() ?? '';
const order = params.get('order') === 'oldest' ? 'oldest' : 'newest';

if (!(INQUIRY_STATUSES as readonly string[]).includes(status)) status = '';
if (!FORM_OPTIONS.includes(formType)) formType = '';

/** Builds a link that preserves the active filters, with optional overrides. */
function withParams(overrides: Record<string, string>): string {
  const merged: Record<string, string> = { status, type: formType, q: search, order, ...overrides };
  const query = new URLSearchParams();
  for (const [key, value] of Object.entries(merged)) {
    // `newest` and empty values are defaults, so they stay out of the URL.
    if (value && !(key === 'order' && value === 'newest')) query.set(key, value);
  }
  const qs = query.toString();
  return qs ? `/admin/messages?${qs}` : '/admin/messages';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  let changed = false;
  if (form.get('action') === 'status') {
    changed = await updateInquiryStatus(String(form.get('id') ?? ''), String(form.get('status') ?? ''));
  }
  return Astro.redirect(withParams(changed ? { updated: '1' } : {}));
}

const [counts, rows] = await Promise.all([
  inquiryCounts(),
  listInquiries({ status, formType, search, order, limit: 200 })
]);

const segments = [
  { id: '', label: 'Toutes', count: counts.total },
  { id: 'new', label: 'Nouvelles', count: counts.byStatus.new },
  { id: 'in_progress', label: 'En cours', count: counts.byStatus.in_progress },
  { id: 'closed', label: 'Clôturées', count: counts.byStatus.closed },
  { id: 'spam', label: 'Indésirables', count: counts.byStatus.spam }
];

const hasFilters = Boolean(status || formType || search);
const nextOrder = order === 'newest' ? 'oldest' : 'newest';
const listHref = withParams({});
const csvHref = `/admin/messages.csv${listHref.includes('?') ? listHref.slice(listHref.indexOf('?')) : ''}`;
---

<AdminLayout title="Messages" active="messages" search={search}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-5xl leading-none font-semibold tracking-tight uppercase">
        <span class="mr-1 text-[#d4a24c]">/</span>Messages
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-[#8b908b]">
        Chaque demande envoyée depuis les formulaires contact, devis et sinistre. Filtrez, puis faites avancer le suivi.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a href={csvHref} class="rounded-full bg-[#f2efe8] px-4 py-2 text-sm font-medium text-[#141716] transition-colors hover:bg-white">
        Exporter CSV
      </a>
      <a
        href={withParams({ order: nextOrder })}
        title={order === 'newest' ? 'Plus anciennes d’abord' : 'Plus récentes d’abord'}
        class="grid h-9 w-9 place-items-center rounded-full border border-[#2f3432] text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={order === 'newest' ? 'M12 19V5M6 11l6-6 6 6' : 'M12 5v14M6 13l6 6 6-6'} />
        </svg>
        <span class="sr-only">Inverser le tri</span>
      </a>
    </div>
  </div>

  {params.get('updated') === '1' && (
    <p class="mt-6 rounded-lg border border-[#2b5c40] bg-[#12241a] px-4 py-2 text-sm text-[#8fd0a8]">Statut mis à jour.</p>
  )}

  <div class="mt-8 flex flex-wrap items-center gap-3 rounded-xl border border-[#262a28] bg-[#111312] px-3 py-3">
    <div class="flex flex-wrap items-center gap-1">
      {segments.map((segment) => (
        <a
          href={withParams({ status: segment.id })}
          aria-current={segment.id === status ? 'true' : undefined}
          class:list={[
            'rounded-lg px-3 py-1.5 text-xs transition-colors',
            segment.id === status
              ? 'border border-[#3a403d] bg-[#1d201f] text-[#f2efe8]'
              : 'border border-transparent text-[#8b908b] hover:text-[#d8d5cd]'
          ]}
        >
          {segment.label}<span class="ml-1.5 text-[#6d726d]">{segment.count}</span>
        </a>
      ))}
    </div>

    <span class="ml-auto flex flex-wrap items-center gap-2">
      {hasFilters && (
        <a href="/admin/messages" class="rounded-full border border-[#2a2f2d] px-3 py-1 text-xs text-[#8b908b] transition-colors hover:text-[#d8d5cd]">
          Effacer les filtres
        </a>
      )}
      {['', ...FORM_OPTIONS].map((id) => (
        <a
          href={withParams({ type: id })}
          class:list={[
            'rounded-full border px-3 py-1 text-xs transition-colors',
            id === formType ? 'border-[#3a403d] bg-[#1d201f] text-[#e8e6e1]' : 'border-[#2a2f2d] text-[#6d726d] hover:text-[#c8c6c0]'
          ]}
        >
          {id ? FORM_LABEL[id] : 'Tous types'}
        </a>
      ))}
    </span>
  </div>

  <div class="mt-4 overflow-hidden rounded-xl border border-[#262a28]">
    <div class="hidden gap-4 border-b border-[#212524] bg-[#0f1110] px-5 py-3 text-[11px] tracking-[.12em] text-[#6d726d] uppercase lg:grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1.3fr)_170px_170px_190px]">
      <span>Demandeur</span>
      <span>Message</span>
      <a href={withParams({ order: nextOrder })} class="inline-flex items-center gap-1 transition-colors hover:text-[#d8d5cd]">
        Chronologie
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={order === 'newest' ? 'M6 15l6-6 6 6' : 'M6 9l6 6 6-6'} />
        </svg>
      </a>
      <span>Formulaire</span>
      <span>Suivi</span>
    </div>

    {rows.length === 0 && (
      <p class="px-5 py-12 text-sm text-[#8b908b]">
        Aucune demande ne correspond à ces filtres.{search && <> Recherche : « {search} ».</>}
      </p>
    )}

    {rows.map((inquiry) => {
      const pill = STATUS_PILL[inquiry.status] ?? STATUS_PILL.new!;
      const isNew = inquiry.status === 'new';
      const stamp = (date: Date) =>
        date.toLocaleString('fr-BE', {
          day: '2-digit',
          month: 'short',
          hour: '2-digit',
          minute: '2-digit',
          timeZone: 'Europe/Brussels'
        });

      return (
        <div
          class:list={[
            'grid gap-4 border-b border-[#191c1b] px-5 py-4 transition-colors last:border-b-0 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1.3fr)_170px_170px_190px] lg:items-start',
            isNew ? 'border-l-2 border-l-[#d4a24c] bg-[#1a1409]' : 'hover:bg-[#141716]'
          ]}
        >
          <div class="flex min-w-0 items-start gap-3">
            <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#2f3432] bg-[#181b1a] text-xs font-medium text-[#c8c6c0]">
              {inquiry.name.trim().slice(0, 2).toUpperCase()}
            </span>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-[#f2efe8]">{inquiry.name}</p>
              <p class="truncate text-xs text-[#8b908b]">{inquiry.email}</p>
              <p class="truncate text-xs text-[#6d726d]">{inquiry.phone}</p>
            </div>
          </div>

          <p class="line-clamp-3 text-xs leading-5 text-[#8b908b]">{inquiry.message}</p>

          <div class="relative pl-4">
            <span class="absolute top-1.5 left-0 h-1.5 w-1.5 rounded-full bg-[#4ea678]" aria-hidden="true" />
            <span class="absolute top-3 left-[2.5px] h-8 border-l border-dotted border-[#3a403d]" aria-hidden="true" />
            <p class="text-xs text-[#c8c6c0]">{stamp(new Date(inquiry.createdAt))}</p>
            <p class="mt-4 text-xs text-[#6d726d]">{stamp(new Date(inquiry.updatedAt))}</p>
          </div>

          <div>
            <span class="inline-flex items-center rounded-full border border-[#2f3432] bg-[#181b1a] px-2.5 py-0.5 text-[11px] text-[#c8c6c0]">
              {FORM_LABEL[inquiry.formType] ?? inquiry.formType}
            </span>
            <p class="mt-1.5 text-[11px] text-[#6d726d]">Page {FORM_PAGE[inquiry.formType] ?? '/'}</p>
          </div>

          <div class="space-y-2">
            <span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-medium', pill.border, pill.bg, pill.text]}>
              <span class:list={['h-1.5 w-1.5 rounded-full', pill.dot]} aria-hidden="true" />
              {pill.label}
            </span>

            <form method="post" class="flex items-center gap-1.5">
              <input type="hidden" name="action" value="status" />
              <input type="hidden" name="id" value={inquiry.id} />
              <label class="sr-only" for={`status-${inquiry.id}`}>Statut de {inquiry.name}</label>
              <select
                id={`status-${inquiry.id}`}
                name="status"
                class="rounded-lg border border-[#2a2f2d] bg-[#141716] px-2 py-1 text-xs text-[#c8c6c0] focus:border-[#d4a24c] focus:outline-none"
              >
                {INQUIRY_STATUSES.map((option) => (
                  <option value={option} selected={option === inquiry.status}>{STATUS_PILL[option]?.label ?? option}</option>
                ))}
              </select>
              <button type="submit" class="rounded-lg border border-[#2a2f2d] px-2 py-1 text-xs text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]">
                OK
              </button>
            </form>
          </div>
        </div>
      );
    })}
  </div>

  <p class="mt-4 text-[11px] text-[#6d726d]">
    {rows.length} demande(s){hasFilters ? ' avec les filtres actifs' : ''} · {order === 'newest' ? 'plus récentes d’abord' : 'plus anciennes d’abord'} · maximum 200 par vue.
  </p>
</AdminLayout>
