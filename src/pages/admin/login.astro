---
import '../../styles/global.css';
import '../../styles/admin.css';
import {
  ADMIN_COOKIE,
  SESSION_TTL_SECONDS,
  allowLoginAttempt,
  clearLoginAttempts,
  clientIp,
  createSessionToken,
  isSecureRequest,
  missingAdminConfig,
  recordLoginFailure,
  safeNextPath,
  verifyAdminCredentials
} from '../../lib/adminAuth';

export const prerender = false;

let error: string | null = null;
const missing = missingAdminConfig();

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const ip = clientIp(Astro.request);
  const username = String(form.get('username') ?? '');
  const password = String(form.get('password') ?? '');
  const destination = safeNextPath(form.get('next'));

  if (missing.length) {
    error = 'Connexion indisponible : configuration incomplète dans Railway.';
  } else if (!allowLoginAttempt(ip)) {
    error = 'Trop de tentatives. Merci de réessayer dans quelques minutes.';
  } else {
    const session = verifyAdminCredentials(username, password);
    const token = session ? createSessionToken(session) : null;

    if (!token) {
      recordLoginFailure();
      // Never log the submitted credentials.
      console.warn('[admin] Failed sign-in from', ip);
      error = 'Identifiants invalides.';
    } else {
      clearLoginAttempts(ip);
      Astro.cookies.set(ADMIN_COOKIE, token, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: isSecureRequest(Astro.request),
        maxAge: SESSION_TTL_SECONDS
      });
      return Astro.redirect(destination);
    }
  }
}

const next = safeNextPath(Astro.url.searchParams.get('next'));
const configured = missing.length === 0;
const signedIn = Astro.locals.admin ?? null;
const justLoggedOut = Astro.url.searchParams.get('loggedout') === '1';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connexion — Administration BDTS</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin-root">
    <div class="grid min-h-screen place-items-center bg-[#0b0c0b] px-6 py-10 text-[#e8e6e1]">
      <div class="w-full max-w-sm">
        <div class="mb-7 flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-[#d4a24c] text-sm font-bold text-[#1a1408]">B</span>
          <span class="text-xs tracking-[.18em] text-[#7f857f] uppercase">Administration</span>
        </div>

        <h1 class="text-4xl leading-none font-semibold tracking-tight uppercase"><span class="mr-1 text-[#d4a24c]">/</span>Connexion</h1>
        <p class="mt-3 text-sm leading-6 text-[#8b908b]">Accès réservé. Toutes les demandes reçues via le site sont visibles après connexion.</p>

        {signedIn && (
          <p class="mt-5 rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#c8c6c0]">
            Vous êtes déjà connecté en tant que <span data-no-translate>{signedIn.username}</span>.
            <a href="/admin" class="text-[#d4a24c] underline-offset-2 hover:underline">Tableau de bord</a>
          </p>
        )}

        {justLoggedOut && (
          <p class="mt-5 rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#c8c6c0]">
            Vous êtes déconnecté.
          </p>
        )}

        {!configured && (
          <p class="mt-5 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-3 py-2 text-xs leading-5 text-[#e0a294]">
            Connexion désactivée. Variables Railway manquantes ou invalides :
            {missing.map((name, index) => <>{index > 0 && ', '}<code class="text-[#f0c9a0]">{name}</code></>)}.
          </p>
        )}

        {error && <p role="alert" class="mt-5 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-3 py-2 text-sm text-[#e0a294]">{error}</p>}

        <form method="post" class="mt-6 space-y-3">
          <input type="hidden" name="next" value={next} />
          <label class="block">
            <span class="text-xs text-[#8b908b]">Identifiant</span>
            <input
              type="text"
              name="username"
              autocapitalize="none"
              spellcheck="false"
              autocomplete="username"
              required
              autofocus
              class="mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#e8e6e1] focus:border-[#d4a24c] focus:outline-none"
            />
          </label>
          <label class="block">
            <span class="text-xs text-[#8b908b]">Mot de passe</span>
            <input
              type="password"
              name="password"
              autocomplete="current-password"
              required
              class="mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#e8e6e1] focus:border-[#d4a24c] focus:outline-none"
            />
          </label>
          <button
            type="submit"
            disabled={!configured}
            class="w-full rounded-lg bg-[#d4a24c] px-4 py-2 text-sm font-medium text-[#1a1408] transition-colors hover:bg-[#e0b162] disabled:cursor-not-allowed disabled:opacity-40"
          >
            Se connecter
          </button>
        </form>

        <p class="mt-6 text-[11px] leading-5 text-[#6d726d]">
          La session est un cookie signé, HttpOnly, valable 8 heures. Le mot de passe n’est jamais stocké en clair.
        </p>
      </div>
    </div>
  </body>
</html>
