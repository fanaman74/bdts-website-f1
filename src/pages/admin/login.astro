---
import '../../styles/global.css';
import '../../styles/admin.css';
import { ADMIN_COOKIE, createSessionToken, isSecureRequest, isSessionConfigured, safeNextPath } from '../../lib/adminAuth';
import { recordLogin, verifyCredentials } from '../../lib/users';

export const prerender = false;

const WINDOW_MS = 15 * 60_000;
const WINDOW_LIMIT = 8;
const attempts = new Map<string, number[]>();

function clientIp(request: Request): string {
  const forwarded = request.headers.get('x-forwarded-for');
  if (forwarded) return forwarded.split(',')[0]!.trim();
  return request.headers.get('x-real-ip') ?? request.headers.get('cf-connecting-ip') ?? 'unknown';
}

function allowAttempt(ip: string): boolean {
  const now = Date.now();
  const recent = (attempts.get(ip) ?? []).filter((timestamp) => now - timestamp < WINDOW_MS);
  if (recent.length >= WINDOW_LIMIT) {
    attempts.set(ip, recent);
    return false;
  }
  recent.push(now);
  attempts.set(ip, recent);
  return true;
}

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const destination = safeNextPath(form.get('next'));

  if (!isSessionConfigured()) {
    error = 'Sessions impossible à signer : définissez ADMIN_SESSION_SECRET dans Railway.';
  } else if (!allowAttempt(clientIp(Astro.request))) {
    error = 'Trop de tentatives. Merci de réessayer dans quelques minutes.';
  } else {
    const user = await verifyCredentials(email, password);
    if (user) {
      const token = createSessionToken(user.id);
      if (token) {
        Astro.cookies.set(ADMIN_COOKIE, token, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          secure: isSecureRequest(Astro.request),
          maxAge: 8 * 60 * 60
        });
        await recordLogin(user.id);
        return Astro.redirect(destination);
      }
      error = 'Session impossible à créer : ADMIN_SESSION_SECRET manquant.';
    } else {
      // Never log the submitted credentials.
      console.warn('[admin] Failed sign-in from', clientIp(Astro.request));
      error = 'Identifiants invalides.';
    }
  }
}

const next = safeNextPath(Astro.url.searchParams.get('next'));
const configured = isSessionConfigured();
const justRegistered = Astro.url.searchParams.get('registered') === '1';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connexion — Administration BDTS</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin-root">
    <div class="grid min-h-screen place-items-center bg-[#0b0c0b] px-6 py-10 text-[#e8e6e1]">
      <div class="w-full max-w-sm">
        <div class="mb-7 flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-[#d4a24c] text-sm font-bold text-[#1a1408]">B</span>
          <span class="text-xs tracking-[.18em] text-[#7f857f] uppercase">Administration</span>
        </div>

        <h1 class="text-4xl leading-none font-semibold tracking-tight uppercase"><span class="mr-1 text-[#d4a24c]">/</span>Connexion</h1>
        <p class="mt-3 text-sm leading-6 text-[#8b908b]">Accès réservé. Toutes les demandes reçues via le site sont visibles après connexion.</p>

        {justRegistered && (
          <p class="mt-5 rounded-lg border border-[#2b5c40] bg-[#12241a] px-3 py-2 text-sm text-[#8fd0a8]">
            Compte créé. Un administrateur doit l’approuver avant que vous puissiez consulter les demandes.
          </p>
        )}

        {!configured && (
          <p class="mt-5 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-3 py-2 text-xs leading-5 text-[#e0a294]">
            Sessions désactivées : définissez <code class="text-[#f0c9a0]">ADMIN_SESSION_SECRET</code> dans les variables Railway.
          </p>
        )}

        {error && <p role="alert" class="mt-5 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-3 py-2 text-sm text-[#e0a294]">{error}</p>}

        <form method="post" class="mt-6 space-y-3">
          <input type="hidden" name="next" value={next} />
          <label class="block">
            <span class="text-xs text-[#8b908b]">Adresse e-mail</span>
            <input
              type="email"
              name="email"
              autocomplete="username"
              required
              autofocus
              class="mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#e8e6e1] focus:border-[#d4a24c] focus:outline-none"
            />
          </label>
          <label class="block">
            <span class="text-xs text-[#8b908b]">Mot de passe</span>
            <input
              type="password"
              name="password"
              autocomplete="current-password"
              required
              class="mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#e8e6e1] focus:border-[#d4a24c] focus:outline-none"
            />
          </label>
          <button
            type="submit"
            disabled={!configured}
            class="w-full rounded-lg bg-[#d4a24c] px-4 py-2 text-sm font-medium text-[#1a1408] transition-colors hover:bg-[#e0b162] disabled:cursor-not-allowed disabled:opacity-40"
          >
            Se connecter
          </button>
        </form>

        <p class="mt-6 text-xs text-[#8b908b]">
          Pas encore de compte ?
          <a href="/admin/register" class="text-[#d4a24c] underline-offset-2 hover:underline">Créer un compte</a>
        </p>
        <p class="mt-3 text-[11px] leading-5 text-[#6d726d]">
          La session est un cookie signé, HttpOnly, valable 8 heures. Les mots de passe ne sont jamais stockés en clair.
        </p>
      </div>
    </div>
  </body>
</html>
