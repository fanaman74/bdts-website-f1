---
/**
 * Landing page for the emailed verification link.
 *
 * The token is single-use: it is looked up by its SHA-256 hash, must be
 * unexpired, and is cleared the moment it is consumed.
 */
import '../../styles/global.css';
import '../../styles/admin.css';
import { findUserByVerificationToken, markEmailVerified } from '../../lib/users';

export const prerender = false;

const token = Astro.url.searchParams.get('token')?.trim() ?? '';

let outcome: 'ok' | 'invalid' | 'missing' = 'missing';
let email: string | null = null;

if (token) {
  const account = await findUserByVerificationToken(token);
  if (account) {
    await markEmailVerified(account.id);
    outcome = 'ok';
    email = account.email;
  } else {
    outcome = 'invalid';
  }
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Confirmation — Administration BDTS</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin-root">
    <div class="grid min-h-screen place-items-center bg-[#0b0c0b] px-6 py-10 text-[#e8e6e1]">
      <div class="w-full max-w-sm">
        <div class="mb-7 flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-[#d4a24c] text-sm font-bold text-[#1a1408]">B</span>
          <span class="text-xs tracking-[.18em] text-[#7f857f] uppercase">Administration</span>
        </div>

        {outcome === 'ok' && (
          <>
            <h1 class="text-4xl leading-none font-semibold tracking-tight uppercase"><span class="mr-1 text-[#d4a24c]">/</span>Confirmé</h1>
            <p class="mt-3 rounded-lg border border-[#2b5c40] bg-[#12241a] px-3 py-3 text-sm leading-6 text-[#8fd0a8]">
              Adresse confirmée pour <span data-no-translate>{email}</span>. Un administrateur doit encore approuver votre compte.
            </p>
            <a href="/admin/login" class="mt-6 block w-full rounded-lg bg-[#d4a24c] px-4 py-2 text-center text-sm font-medium text-[#1a1408] transition-colors hover:bg-[#e0b162]">
              Se connecter
            </a>
          </>
        )}

        {outcome === 'invalid' && (
          <>
            <h1 class="text-4xl leading-none font-semibold tracking-tight uppercase"><span class="mr-1 text-[#d4a24c]">/</span>Lien invalide</h1>
            <p class="mt-3 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-3 py-3 text-sm leading-6 text-[#e0a294]">
              Ce lien de confirmation est inconnu ou expiré. Les liens sont valables 24 heures et ne servent qu’une fois.
            </p>
            <a href="/admin/login" class="mt-6 block w-full rounded-lg border border-[#2a2f2d] px-4 py-2 text-center text-sm text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]">
              Demander un nouvel envoi
            </a>
          </>
        )}

        {outcome === 'missing' && (
          <>
            <h1 class="text-4xl leading-none font-semibold tracking-tight uppercase"><span class="mr-1 text-[#d4a24c]">/</span>Confirmation</h1>
            <p class="mt-3 text-sm leading-6 text-[#8b908b]">
              Ouvrez le lien reçu par e-mail pour confirmer votre adresse.
            </p>
            <a href="/admin/login" class="mt-6 block w-full rounded-lg border border-[#2a2f2d] px-4 py-2 text-center text-sm text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]">
              Retour à la connexion
            </a>
          </>
        )}
      </div>
    </div>
  </body>
</html>
