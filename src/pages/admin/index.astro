---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { cachedDocumentCount, inquiryCounts, listInquiries } from '../../lib/inquiries';
import {
  DECLARATION_STATUS_LABELS,
  declarationCounts,
  declarationName,
  listDeclarations
} from '../../lib/declarations';

export const prerender = false;

const STATUS_LABEL: Record<string, string> = {
  new: 'Nouveau',
  in_progress: 'En cours',
  closed: 'Clôturé',
  spam: 'Indésirable'
};

const FORM_LABEL: Record<string, string> = {
  contact: 'Contact',
  devis: 'Devis',
  declaration: 'Sinistre'
};

const [counts, cached] = await Promise.all([inquiryCounts(), cachedDocumentCount()]);

const [recent, declarationTotals, recentDeclarations] = await Promise.all([
  listInquiries({ limit: 6 }),
  declarationCounts(),
  listDeclarations({ limit: 5 })
]);

const tiles = [
  { label: 'Soumissions', value: counts.total, hint: 'depuis la mise en ligne', accent: false },
  { label: 'Nouvelles', value: counts.byStatus.new, hint: 'à traiter', accent: true },
  { label: 'En cours', value: counts.byStatus.in_progress, hint: 'suivi engagé', accent: false },
  { label: 'Clôturées', value: counts.byStatus.closed, hint: 'traitées', accent: false },
  { label: 'Indésirables', value: counts.byStatus.spam, hint: 'écartées', accent: false },
  { label: 'Documents en cache', value: cached, hint: 'PDF analysés', accent: false },
  { label: 'Déclarations', value: declarationTotals.total, hint: 'sinistres reçus', accent: false },
  { label: 'Sinistres à traiter', value: declarationTotals.byStatus.new, hint: 'nouveaux dossiers', accent: true }
];
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-4xl font-semibold tracking-tight uppercase"><span class="text-[#d4a24c]">/</span> Dashboard</h1>
      <p class="mt-2 text-sm text-[#8b908b]">Toutes les demandes reçues via les formulaires du site.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/admin/messages" class="rounded-lg bg-[#f2efe8] px-4 py-2 text-sm font-medium text-[#141716] transition-colors hover:bg-white">Ouvrir les messages</a>
      <a href="/admin/declarations" class="rounded-lg border border-[#2a2f2d] px-4 py-2 text-sm text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]">Ouvrir les déclarations</a>
    </div>
  </div>

  <section class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {tiles.map((tile) => (
      <div class:list={[
        'rounded-xl border px-4 py-4',
        tile.accent && tile.value > 0 ? 'border-[#5a4620] bg-[#241a0d]' : 'border-[#262a28] bg-[#111312]'
      ]}>
        <p class="text-[11px] tracking-[.12em] text-[#7f857f] uppercase">{tile.label}</p>
        <p class:list={['mt-2 text-2xl font-semibold', tile.accent && tile.value > 0 ? 'text-[#e0b568]' : 'text-[#f2efe8]']}>{tile.value}</p>
        <p class="mt-1 text-[11px] text-[#6d726d]">{tile.hint}</p>
      </div>
    ))}
  </section>

  <div class="mt-10">
    <section>
      <h2 class="text-sm tracking-[.12em] text-[#7f857f] uppercase">Dernières demandes</h2>
      <div class="mt-4 divide-y divide-[#212524] overflow-hidden rounded-xl border border-[#262a28]">
        {recent.length === 0 && <p class="px-5 py-8 text-sm text-[#8b908b]">Aucune demande pour le moment.</p>}
        {recent.map((inquiry) => (
          <div class="flex items-start gap-4 px-5 py-4 transition-colors hover:bg-[#141716]">
            <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#2f3432] bg-[#181b1a] text-xs font-medium text-[#c8c6c0]">
              {inquiry.name.trim().slice(0, 2).toUpperCase()}
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-[#f2efe8]">{inquiry.name}</p>
              <p class="truncate text-xs text-[#8b908b]">{inquiry.email} · {inquiry.phone}</p>
              <p class="mt-1.5 line-clamp-2 text-xs leading-5 text-[#6d726d]">{inquiry.message}</p>
            </div>
            <div class="shrink-0 text-right">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2f3432] bg-[#181b1a] px-2 py-0.5 text-[11px] text-[#c8c6c0]">
                {FORM_LABEL[inquiry.formType] ?? inquiry.formType}
              </span>
              <p class="mt-2 text-[11px] text-[#6d726d]">{new Date(inquiry.createdAt).toLocaleDateString('fr-BE')}</p>
              <p class="text-[11px] text-[#8b908b]">{STATUS_LABEL[inquiry.status] ?? inquiry.status}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

  <section class="mt-8">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-sm tracking-[.12em] text-[#7f857f] uppercase">Dernières déclarations</h2>
      <a href="/admin/declarations" class="text-xs text-[#d4a24c] underline-offset-2 hover:underline">Tout afficher →</a>
    </div>

    <div class="mt-4 divide-y divide-[#212524] overflow-hidden rounded-xl border border-[#262a28]">
      {recentDeclarations.length === 0 && (
        <p class="px-5 py-8 text-sm text-[#8b908b]">Aucune déclaration de sinistre pour le moment.</p>
      )}
      {recentDeclarations.map((declaration) => (
        <a
          href={`/admin/declarations/${declaration.id}`}
          class="flex items-start gap-4 px-5 py-4 transition-colors hover:bg-[#141716]"
        >
          <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#2f3432] bg-[#181b1a] text-xs font-medium text-[#c8c6c0]">
            {declaration.firstName.trim().slice(0, 1).concat(declaration.lastName.trim().slice(0, 1)).toUpperCase()}
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-[#f2efe8]">{declarationName(declaration)}</p>
            <p class="truncate text-xs text-[#8b908b]">{declaration.email}</p>
            <p class="mt-1.5 line-clamp-2 text-xs leading-5 text-[#6d726d]">
              {[declaration.incidentPlace, declaration.incidentCircumstances].filter(Boolean).join(' · ') || 'Aucune description fournie.'}
            </p>
          </div>
          <div class="shrink-0 text-right">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2f3432] bg-[#181b1a] px-2 py-0.5 text-[11px] text-[#c8c6c0]">
              {DECLARATION_STATUS_LABELS[declaration.status]}
            </span>
            <p class="mt-2 text-[11px] text-[#6d726d]">{new Date(declaration.createdAt).toLocaleDateString('fr-BE')}</p>
            {declaration.attachmentCount > 0 && (
              <p class="text-[11px] text-[#8b908b]">{declaration.attachmentCount} pièce(s)</p>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</AdminLayout>
