---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  DECLARATION_STATUSES,
  DECLARATION_STATUS_LABELS,
  declarationCounts,
  declarationName,
  declarationTitleLabel,
  listDeclarations,
  updateDeclarationStatus,
  type Declaration
} from '../../lib/declarations';

export const prerender = false;

const STATUS_PILL: Record<string, { dot: string; text: string; bg: string; border: string }> = {
  new: { dot: 'bg-[#e0b568]', text: 'text-[#e0b568]', bg: 'bg-[#241a0d]', border: 'border-[#5a4620]' },
  in_progress: { dot: 'bg-[#7fb7d6]', text: 'text-[#7fb7d6]', bg: 'bg-[#12222b]', border: 'border-[#275065]' },
  closed: { dot: 'bg-[#4ea678]', text: 'text-[#8fd0a8]', bg: 'bg-[#12241a]', border: 'border-[#2b5c40]' },
  spam: { dot: 'bg-[#d1695a]', text: 'text-[#e08b7c]', bg: 'bg-[#2a1614]', border: 'border-[#5e2f28]' }
};

const params = Astro.url.searchParams;
let status = params.get('status') ?? '';
const search = params.get('q')?.trim() ?? '';
const order = params.get('order') === 'oldest' ? 'oldest' : 'newest';

if (!(DECLARATION_STATUSES as readonly string[]).includes(status)) status = '';

/** Builds a link that preserves the active filters, with optional overrides. */
function withParams(overrides: Record<string, string>): string {
  const merged: Record<string, string> = { status, q: search, order, ...overrides };
  const query = new URLSearchParams();
  for (const [key, value] of Object.entries(merged)) {
    // `newest` and empty values are defaults, so they stay out of the URL.
    if (value && !(key === 'order' && value === 'newest')) query.set(key, value);
  }
  const qs = query.toString();
  return qs ? `/admin/declarations?${qs}` : '/admin/declarations';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  let changed = false;
  if (form.get('action') === 'status') {
    changed = await updateDeclarationStatus(String(form.get('id') ?? ''), String(form.get('status') ?? ''));
  }
  return Astro.redirect(withParams(changed ? { updated: '1' } : {}));
}

const [counts, rows] = await Promise.all([
  declarationCounts(),
  listDeclarations({ status, search, order, limit: 200 })
]);

const segments = [
  { id: '', label: 'Toutes', count: counts.total },
  { id: 'new', label: 'Nouvelles', count: counts.byStatus.new },
  { id: 'in_progress', label: 'En cours', count: counts.byStatus.in_progress },
  { id: 'closed', label: 'Clôturées', count: counts.byStatus.closed },
  { id: 'spam', label: 'Indésirables', count: counts.byStatus.spam }
];

const hasFilters = Boolean(status || search);
const nextOrder = order === 'newest' ? 'oldest' : 'newest';
const listHref = withParams({});
const csvHref = `/admin/declarations.csv${listHref.includes('?') ? listHref.slice(listHref.indexOf('?')) : ''}`;
const updated = params.get('updated') === '1';

const stamp = (date: Date) =>
  new Intl.DateTimeFormat('fr-BE', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Europe/Brussels'
  }).format(date);

/** The most useful line of the claim, for the collapsed list. */
function summaryOf(declaration: Declaration): string {
  const parts = [declaration.insuredPersonOrItem, declaration.incidentPlace, declaration.incidentCircumstances]
    .map((value) => value?.trim())
    .filter((value): value is string => Boolean(value));
  return parts.join(' · ') || 'Aucune description fournie.';
}

function incidentWhen(declaration: Declaration): string {
  const date = declaration.incidentDate ?? '';
  const time = (declaration.incidentTime ?? '').slice(0, 5);
  if (!date) return '';
  return time ? `${date} · ${time}` : date;
}
---

<AdminLayout title="Déclarations" active="declarations" search={search} searchAction="/admin/declarations">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-5xl leading-none font-semibold tracking-tight uppercase">
        <span class="mr-1 text-[#d4a24c]">/</span>Déclarations
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-[#8b908b]">
        Les sinistres déclarés depuis la page <span class="text-[#c8c6c0]">/declaration</span>. Chaque dossier reprend les
        informations de contact, l’identification du sinistre, le témoin et la partie adverse éventuels, ainsi que les pièces
        jointes.
      </p>
    </div>
    <a
      href={csvHref}
      class="rounded-lg border border-[#2a2f2d] px-4 py-2 text-sm text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]"
    >
      Exporter en CSV
    </a>
  </div>

  {updated && (
    <p class="mt-6 rounded-lg border border-[#2b5c40] bg-[#12241a] px-4 py-2 text-sm text-[#8fd0a8]">Statut mis à jour.</p>
  )}

  <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label="Filtrer par statut">
    {segments.map((segment) => (
      <a
        href={withParams({ status: segment.id })}
        aria-current={status === segment.id ? 'page' : undefined}
        class:list={[
          'rounded-full border px-3 py-1.5 text-xs transition-colors',
          status === segment.id
            ? 'border-[#d4a24c] text-[#e0b568]'
            : 'border-[#2a2f2d] text-[#8b908b] hover:border-[#3a403d] hover:text-[#c8c6c0]'
        ]}
      >
        {segment.label} <span class="text-[#6d726d]">({segment.count})</span>
      </a>
    ))}
    <a
      href={withParams({ order: nextOrder })}
      class="ml-auto rounded-full border border-[#2a2f2d] px-3 py-1.5 text-xs text-[#8b908b] transition-colors hover:border-[#3a403d] hover:text-[#c8c6c0]"
    >
      Trier : {order === 'newest' ? 'plus récentes' : 'plus anciennes'}
    </a>
  </nav>

  <div class="mt-6 divide-y divide-[#212524] overflow-hidden rounded-xl border border-[#262a28]">
    {rows.length === 0 && (
      <p class="px-5 py-10 text-sm text-[#8b908b]">
        Aucune déclaration {hasFilters ? 'avec les filtres actifs' : 'pour le moment'}.
      </p>
    )}

    {rows.map((declaration) => {
      const pill = STATUS_PILL[declaration.status] ?? STATUS_PILL.new!;
      const isNew = declaration.status === 'new';
      const when = incidentWhen(declaration);
      return (
        <div
          class:list={[
            'grid gap-4 border-b border-[#191c1b] px-5 py-4 transition-colors last:border-b-0 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)_190px_170px] lg:items-start',
            isNew ? 'border-l-2 border-l-[#d4a24c] bg-[#1a1409]' : 'hover:bg-[#141716]'
          ]}
        >
          <div class="flex min-w-0 items-start gap-3">
            <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#2f3432] bg-[#181b1a] text-xs font-medium text-[#c8c6c0]">
              {declaration.firstName.trim().slice(0, 1).concat(declaration.lastName.trim().slice(0, 1)).toUpperCase()}
            </span>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-[#f2efe8]">
                {declarationTitleLabel(declaration.personTitle)} {declarationName(declaration)}
              </p>
              <p class="truncate text-xs text-[#8b908b]">{declaration.email}</p>
              <p class="truncate text-xs text-[#6d726d]">
                {[declaration.phoneMobile, declaration.phoneFixed].filter(Boolean).join(' · ') || 'Téléphone non communiqué'}
              </p>
            </div>
          </div>

          <div class="min-w-0">
            {when && <p class="text-xs text-[#c8c6c0]">Sinistre : {when}</p>}
            {declaration.insurancePolicyNumber && (
              <p class="mt-0.5 truncate text-[11px] text-[#6d726d]">Police {declaration.insurancePolicyNumber}</p>
            )}
            <p class="mt-1.5 line-clamp-3 text-xs leading-5 text-[#8b908b]">{summaryOf(declaration)}</p>
          </div>

          <div class="flex flex-wrap items-center gap-1.5 lg:block lg:space-y-1.5">
            <p class="text-xs text-[#c8c6c0]">{stamp(new Date(declaration.createdAt))}</p>
            {declaration.counterpartyPresent && (
              <span class="inline-flex rounded-full border border-[#2f3432] bg-[#181b1a] px-2 py-0.5 text-[11px] text-[#c8c6c0]">Partie adverse</span>
            )}
            {declaration.witnessPresent && (
              <span class="inline-flex rounded-full border border-[#2f3432] bg-[#181b1a] px-2 py-0.5 text-[11px] text-[#c8c6c0]">Témoin</span>
            )}
            {declaration.attachmentCount > 0 && (
              <span class="inline-flex rounded-full border border-[#2f3432] bg-[#181b1a] px-2 py-0.5 text-[11px] text-[#c8c6c0]">
                {declaration.attachmentCount} pièce(s)
              </span>
            )}
          </div>

          <div class="space-y-2">
            <span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-medium', pill.border, pill.bg, pill.text]}>
              <span class:list={['h-1.5 w-1.5 rounded-full', pill.dot]} aria-hidden="true" />
              {DECLARATION_STATUS_LABELS[declaration.status]}
            </span>

            <form method="post" class="flex items-center gap-1.5">
              <input type="hidden" name="action" value="status" />
              <input type="hidden" name="id" value={declaration.id} />
              <label class="sr-only" for={`status-${declaration.id}`}>Statut de {declarationName(declaration)}</label>
              <select
                id={`status-${declaration.id}`}
                name="status"
                class="rounded-lg border border-[#2a2f2d] bg-[#141716] px-2 py-1 text-xs text-[#c8c6c0] focus:border-[#d4a24c] focus:outline-none"
              >
                {DECLARATION_STATUSES.map((option) => (
                  <option value={option} selected={option === declaration.status}>{DECLARATION_STATUS_LABELS[option]}</option>
                ))}
              </select>
              <button type="submit" class="rounded-lg border border-[#2a2f2d] px-2 py-1 text-xs text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]">
                OK
              </button>
            </form>

            <a
              href={`/admin/declarations/${declaration.id}`}
              class="inline-block text-xs text-[#d4a24c] underline-offset-2 hover:underline"
            >
              Ouvrir le dossier →
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <p class="mt-4 text-[11px] text-[#6d726d]">
    {rows.length} déclaration(s){hasFilters ? ' avec les filtres actifs' : ''} · {order === 'newest' ? 'plus récentes d’abord' : 'plus anciennes d’abord'} · maximum 200 par vue.
  </p>


</AdminLayout>

