---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminUsername } from '../../lib/adminAuth';
import {
  createUser,
  deleteUser,
  isDatabaseConfigured,
  isUserRole,
  listUsers,
  ROLE_LABEL,
  setUserPassword,
  updateUserRole,
  USER_ROLES,
  type UserRole
} from '../../lib/users';

export const prerender = false;

// The middleware already limits this page to the admin role.
const me = Astro.locals.admin!;
const MIN_PASSWORD = 12;

const ROLE_PILL: Record<UserRole | 'inactive', string> = {
  admin: 'border-[#2b5c40] bg-[#12241a] text-[#8fd0a8]',
  member: 'border-[#275065] bg-[#12222b] text-[#7fb7d6]',
  inactive: 'border-[#5a4620] bg-[#241a0d] text-[#e0b568]'
};

let notice: string | null = null;
let problem: string | null = null;
let openAddForm = false;
let draft = { email: '', name: '', role: 'member' as UserRole };

const databaseReady = isDatabaseConfigured();

if (Astro.request.method === 'POST' && databaseReady) {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'create') {
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    const name = String(form.get('name') ?? '').trim();
    const password = String(form.get('password') ?? '');
    const role = String(form.get('role') ?? '');
    draft = { email, name, role: isUserRole(role) ? role : 'member' };

    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      problem = 'Adresse e-mail invalide.';
    } else if (!isUserRole(role)) {
      problem = 'Rôle inconnu.';
    } else if (password.length < MIN_PASSWORD) {
      problem = `Le mot de passe doit faire au moins ${MIN_PASSWORD} caractères.`;
    } else {
      const result = await createUser({ email, name, password, role });
      if (result.ok) {
        notice = `${result.user.email} ajouté comme ${ROLE_LABEL[role].toLowerCase()}. Communiquez-lui son mot de passe par un canal sûr.`;
        draft = { email: '', name: '', role: 'member' };
      } else {
        problem = result.reason === 'exists' ? 'Un utilisateur existe déjà avec cette adresse.' : 'Base de données indisponible.';
      }
    }
    openAddForm = problem !== null;
  } else {
    const id = String(form.get('id') ?? '');
    const target = (await listUsers()).find((account) => account.id === id);
    const isSelf = me.kind === 'user' && me.id === id;

    if (!target) {
      problem = 'Utilisateur introuvable.';
    } else if (action === 'role') {
      const role = String(form.get('role') ?? '');
      if (!isUserRole(role)) {
        problem = 'Rôle inconnu.';
      } else if (isSelf && role !== 'admin') {
        problem = 'Vous ne pouvez pas retirer votre propre rôle d’administrateur.';
      } else {
        await updateUserRole(target.id, role);
        notice = `Rôle de ${target.email} : ${ROLE_LABEL[role]}.`;
      }
    } else if (action === 'password') {
      const password = String(form.get('password') ?? '');
      if (password.length < MIN_PASSWORD) {
        problem = `Le mot de passe doit faire au moins ${MIN_PASSWORD} caractères.`;
      } else {
        await setUserPassword(target.id, password);
        notice = isSelf
          ? 'Votre mot de passe a été changé. Reconnectez-vous avec le nouveau.'
          : `Mot de passe de ${target.email} changé. Ses sessions ouvertes sont fermées.`;
      }
    } else if (action === 'delete') {
      if (isSelf) {
        problem = 'Vous ne pouvez pas supprimer votre propre compte.';
      } else {
        await deleteUser(target.id);
        notice = `${target.email} supprimé.`;
      }
    }
  }
}

const accounts = databaseReady ? await listUsers() : [];
const dateFr = (iso: string) => new Date(iso).toLocaleDateString('fr-BE');

const input =
  'mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#141716] px-3 py-2 text-sm text-[#e8e6e1] focus:border-[#d4a24c] focus:outline-none';
const smallButton =
  'rounded-lg border border-[#2a2f2d] px-2 py-1 text-xs text-[#c8c6c0] transition-colors hover:border-[#d4a24c] hover:text-[#e0b568]';
---

<AdminLayout title="Utilisateurs" active="users">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-5xl leading-none font-semibold tracking-tight uppercase"><span class="mr-1 text-[#d4a24c]">/</span>Utilisateurs</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-[#8b908b]">
        Les administrateurs ont accès à tout. Les collaborateurs consultent et traitent les messages et les déclarations,
        sans accès aux utilisateurs ni aux réglages.
      </p>
    </div>
  </div>

  {notice && <p class="mt-6 rounded-lg border border-[#2b5c40] bg-[#12241a] px-4 py-2 text-sm text-[#8fd0a8]">{notice}</p>}
  {problem && <p role="alert" class="mt-6 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-4 py-2 text-sm text-[#e0a294]">{problem}</p>}

  {!databaseReady && (
    <p class="mt-6 rounded-lg border border-[#5a4620] bg-[#241a0d] px-4 py-2 text-sm text-[#e0b568]">
      Base de données non configurée (<code>DATABASE_URL</code>) : impossible d’ajouter des utilisateurs.
    </p>
  )}

  {databaseReady && (
    <details class="group mt-6 rounded-xl border border-[#262a28] bg-[#111312]" open={openAddForm}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 [&::-webkit-details-marker]:hidden">
        <span class="text-sm font-medium text-[#f2efe8]">Nouvel utilisateur</span>
        <span class="rounded-lg bg-[#d4a24c] px-3 py-2 text-xs font-medium text-[#1a1408] transition-colors group-open:bg-[#2a2f2d] group-open:text-[#c8c6c0] hover:bg-[#e0b162]">
          <span class="group-open:hidden">+ Ajouter un utilisateur</span>
          <span class="hidden group-open:inline">Fermer</span>
        </span>
      </summary>

      <form method="post" class="grid gap-4 border-t border-[#212524] px-5 py-5 md:grid-cols-2">
        <input type="hidden" name="action" value="create" />
        <label class="block">
          <span class="text-xs text-[#8b908b]">Adresse e-mail (identifiant de connexion)</span>
          <input type="email" name="email" required autocomplete="off" value={draft.email} class={input} />
        </label>
        <label class="block">
          <span class="text-xs text-[#8b908b]">Nom (facultatif)</span>
          <input type="text" name="name" autocomplete="off" value={draft.name} class={input} />
        </label>
        <label class="block">
          <span class="text-xs text-[#8b908b]">Mot de passe initial ({MIN_PASSWORD} caractères minimum)</span>
          <input type="password" name="password" required minlength={MIN_PASSWORD} autocomplete="new-password" class={input} />
        </label>
        <label class="block">
          <span class="text-xs text-[#8b908b]">Rôle</span>
          <select name="role" class={input}>
            {USER_ROLES.map((role) => <option value={role} selected={role === draft.role}>{ROLE_LABEL[role]}</option>)}
          </select>
        </label>
        <div class="md:col-span-2">
          <button type="submit" class="rounded-lg bg-[#d4a24c] px-4 py-2 text-sm font-medium text-[#1a1408] transition-colors hover:bg-[#e0b162]">
            Créer l’utilisateur
          </button>
        </div>
      </form>
    </details>
  )}

  <div class="mt-8 overflow-hidden rounded-xl border border-[#262a28]">
    <div class="hidden gap-4 border-b border-[#212524] bg-[#0f1110] px-5 py-3 text-[11px] tracking-[.12em] text-[#6d726d] uppercase lg:grid lg:grid-cols-[minmax(0,1.4fr)_130px_150px_minmax(0,1.6fr)]">
      <span>Utilisateur</span>
      <span>Rôle</span>
      <span>Activité</span>
      <span>Actions</span>
    </div>

    <div class="grid gap-4 border-b border-[#191c1b] px-5 py-4 lg:grid-cols-[minmax(0,1.4fr)_130px_150px_minmax(0,1.6fr)] lg:items-center">
      <div class="min-w-0">
        <p class="truncate text-sm font-medium text-[#f2efe8]" data-no-translate>{adminUsername()}</p>
        <p class="text-xs text-[#8b908b]">Compte principal (variables Railway)</p>
      </div>
      <div>
        <span class={`inline-flex rounded-full border px-2.5 py-0.5 text-[11px] font-medium ${ROLE_PILL.admin}`}>{ROLE_LABEL.admin}</span>
      </div>
      <p class="text-xs text-[#6d726d]">Toujours actif</p>
      <p class="text-xs text-[#6d726d]">Modifiable uniquement dans Railway.</p>
    </div>

    {accounts.map((account) => {
      const isSelf = me.kind === 'user' && me.id === account.id;
      const pill = account.canSignIn && account.role ? account.role : 'inactive';
      return (
        <div class="grid gap-4 border-b border-[#191c1b] px-5 py-4 last:border-b-0 lg:grid-cols-[minmax(0,1.4fr)_130px_150px_minmax(0,1.6fr)] lg:items-center">
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-[#f2efe8]" data-no-translate>{account.name?.trim() || account.email}{isSelf && ' (vous)'}</p>
            <p class="truncate text-xs text-[#8b908b]" data-no-translate>{account.email}</p>
          </div>

          <div>
            <span class={`inline-flex rounded-full border px-2.5 py-0.5 text-[11px] font-medium ${ROLE_PILL[pill]}`}>
              {pill === 'inactive' ? 'Inactif' : ROLE_LABEL[pill]}
            </span>
            {!account.canSignIn && (
              <p class="mt-1 text-[11px] leading-4 text-[#8b908b]">Choisissez un rôle et un nouveau mot de passe pour l’activer.</p>
            )}
          </div>

          <div class="text-xs text-[#6d726d]">
            <p>Créé le {dateFr(account.createdAt)}</p>
            <p class="mt-1">{account.lastLoginAt ? `Connexion le ${dateFr(account.lastLoginAt)}` : 'Jamais connecté'}</p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <form method="post" class="flex items-center gap-1.5">
              <input type="hidden" name="action" value="role" />
              <input type="hidden" name="id" value={account.id} />
              <label class="sr-only" for={`role-${account.id}`}>Rôle de {account.email}</label>
              <select id={`role-${account.id}`} name="role" disabled={isSelf} class="rounded-lg border border-[#2a2f2d] bg-[#141716] px-2 py-1 text-xs text-[#c8c6c0] focus:border-[#d4a24c] focus:outline-none disabled:opacity-50">
                {account.role === null && <option value="" selected disabled>Choisir…</option>}
                {USER_ROLES.map((role) => <option value={role} selected={role === account.role}>{ROLE_LABEL[role]}</option>)}
              </select>
              {!isSelf && <button type="submit" class={smallButton}>OK</button>}
            </form>

            <form method="post" class="flex items-center gap-1.5">
              <input type="hidden" name="action" value="password" />
              <input type="hidden" name="id" value={account.id} />
              <label class="sr-only" for={`password-${account.id}`}>Nouveau mot de passe pour {account.email}</label>
              <input
                id={`password-${account.id}`}
                type="password"
                name="password"
                required
                minlength={MIN_PASSWORD}
                autocomplete="new-password"
                placeholder="Nouveau mot de passe"
                class="w-40 rounded-lg border border-[#2a2f2d] bg-[#141716] px-2 py-1 text-xs text-[#c8c6c0] placeholder:text-[#6d726d] focus:border-[#d4a24c] focus:outline-none"
              />
              <button type="submit" class={smallButton}>Changer</button>
            </form>

            {!isSelf && (
              <form method="post" onsubmit={`return confirm('Supprimer ${account.email.replace(/'/g, '')} ?')`}>
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={account.id} />
                <button type="submit" class="rounded-lg border border-[#2a2f2d] px-2 py-1 text-xs text-[#8b908b] transition-colors hover:border-[#5e2f28] hover:text-[#e08b7c]">Supprimer</button>
              </form>
            )}
          </div>
        </div>
      );
    })}

    {databaseReady && accounts.length === 0 && (
      <p class="px-5 py-6 text-sm text-[#8b908b]">Aucun autre utilisateur pour l’instant. Utilisez « Ajouter un utilisateur » ci-dessus.</p>
    )}
  </div>
</AdminLayout>
