---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PageHero from '../components/PageHero.astro';

const types = [
  'Attestation de sinistralité (historique de vos sinistres, pour changer d’assureur ou reprendre un bonus)',
  'Carte verte ou certificat d’assurance (voyage, véhicule)',
  'Attestation d’assurance habitation (propriétaire, locataire, bailleur)',
  'Attestation fiscale (épargne-pension, assurance-vie)',
  'Attestation pour un visa ou une mission (assurance voyage)'
];
---

<BaseLayout
  title="Demander une attestation"
  description="Demandez une attestation d’assurance : sinistralité, carte verte, habitation, fiscale ou visa. Nous vous répondons rapidement."
>
  <div class="page-shell">
    <PageHero eyebrow="Attestations" title="Une attestation, sans chercher." description="Dites-nous laquelle il vous faut et pour quel contrat. Nous vous l’envoyons ou vous indiquons le délai." image="/images/photos/particulier-famille-protection-assurance-familiale.jpg" compact />

  <div class="organic-form-layout">
    <section aria-label="Formulaire de demande d’attestation" class="card p-6 sm:p-8">
      <InquiryForm
        formType="attestation"
        messageLabel="Quelle attestation, pour quel contrat et pour quelle date ?"
        messagePlaceholder="Ex. : attestation de sinistralité pour mon véhicule (plaque 1-ABC-123), à envoyer avant le 15 novembre…"
      />
    </section>

    <aside class="space-y-6">
      <div class="card p-6">
        <p class="eyebrow text-pulse-600">Les plus demandées</p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-ink-700">
          {types.map((type) => <li>{type}</li>)}
        </ul>
      </div>
      <div class="card p-6">
        <p class="eyebrow text-coral-600">Bon à savoir</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          Indiquez le numéro de police ou la plaque d’immatriculation si vous les avez. Nous ne demandons l’attestation à votre assureur qu’avec votre accord.
        </p>
      </div>
    </aside>
  </div>
  </div>
</BaseLayout>
