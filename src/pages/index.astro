---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PartnerMarquee from '../components/PartnerMarquee.astro';
import { portals } from '../data/portals';
import { serviceImage } from '../data/cardImages';
import { t } from '../i18n/fr';

const services = await getCollection('services');
const featured = services
  .filter((service) => service.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const particulier = services
  .filter((service) => service.data.audience === 'particulier')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const professionnel = services
  .filter((service) => service.data.audience === 'professionnel')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const documentCount = 25;
const arrowPath = 'M3 10h13M11 5l5 5-5 5';
---

<BaseLayout title={t.site.name} description={t.site.description} bodyClass="home-swiss">
  <Hero />
  <PartnerMarquee />

  <section class="swiss-section swiss-coverage" aria-labelledby="coverage-title">
    <div class="swiss-frame">
      <header class="swiss-section-header reveal">
        <p>Domaines d'intervention</p>
        <h2 id="coverage-title">Une lecture claire<br />de ce qui doit être protégé.</h2>
        <p>
          Nous examinons votre situation avant de comparer les garanties, les exclusions et le coût réel des contrats.
        </p>
      </header>

      <ol class="swiss-coverage-index">
        {
          featured.map((service, index) => (
            <li class="reveal">
              <a href={`/${service.id}`}>
                <span class="swiss-folio">{String(index + 1).padStart(2, '0')}</span>
                <span class="swiss-coverage-copy">
                  <strong>{service.data.title}</strong>
                  <span>{service.data.summary}</span>
                </span>
                <span class="swiss-coverage-image" aria-hidden="true">
                  <img src={service.data.heroImage ?? serviceImage(service.id)} alt="" width="420" height="280" loading="lazy" />
                </span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath} /></svg>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="swiss-service-directory" aria-label="Répertoire des assurances">
    <div class="swiss-frame swiss-directory-grid">
      <article class="reveal">
        <div class="swiss-directory-heading">
          <span>Particuliers</span>
          <h2>Votre quotidien,<br />sans angle mort.</h2>
        </div>
        <ul>
          {
            particulier.slice(0, 8).map((service, index) => (
              <li>
                <a href={`/${service.id}`}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{service.data.title}</strong>
                </a>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="reveal">
        <div class="swiss-directory-heading swiss-directory-heading-blue">
          <span>Professionnels</span>
          <h2>Votre activité,<br />avec méthode.</h2>
        </div>
        <ul>
          {
            professionnel.slice(0, 8).map((service, index) => (
              <li>
                <a href={`/${service.id}`}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{service.data.title}</strong>
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="swiss-practical" aria-labelledby="practical-title">
    <div class="swiss-frame swiss-practical-grid">
      <div class="swiss-practical-lead reveal">
        <p>Accès direct</p>
        <h2 id="practical-title">Le contrat ne s'arrête pas à la signature.</h2>
        <p>Retrouvez les documents utiles et accédez à vos espaces personnels sécurisés.</p>
      </div>

      <a href="/documents" class="swiss-document-block reveal">
        <span>Bibliothèque</span>
        <strong>{documentCount}</strong>
        <h3>Documents produits classés et consultables</h3>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath} /></svg>
      </a>

      <div class="swiss-portal-list reveal">
        <p>Espaces personnels</p>
        {portals.map((portal) => (
          <a href={portal.url} target="_blank" rel="noopener noreferrer">
            <span>
              <strong>{portal.name}</strong>
              <small>{portal.label}</small>
            </span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath} /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="swiss-news swiss-section" aria-labelledby="news-title">
    <div class="swiss-frame">
      <header class="swiss-section-header swiss-news-header reveal">
        <p>Actualités</p>
        <h2 id="news-title">Ce qui change,<br />ce qu'il faut retenir.</h2>
        <a href="/actualites">Voir toutes les actualités</a>
      </header>

      <div class="swiss-news-list">
        {news.map((article, index) => (
          <article class="reveal">
            <span class="swiss-folio">{String(index + 1).padStart(2, '0')}</span>
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('fr-BE', { day: '2-digit', month: '2-digit', year: 'numeric' })}
            </time>
            <h3><a href={`/actualites/${article.id}`}>{article.data.title}</a></h3>
            <p>{article.data.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="swiss-closing" aria-labelledby="closing-title">
    <div class="swiss-frame swiss-closing-grid">
      <p>Une question mérite mieux qu'un formulaire anonyme.</p>
      <h2 id="closing-title">Parlons de votre situation.</h2>
      <div class="swiss-actions">
        <a href="/contact" class="swiss-action swiss-action-primary">Nous contacter</a>
        <a href="tel:+3224631925" class="swiss-action">+32 2 463 19 25</a>
      </div>
    </div>
  </section>
</BaseLayout>
