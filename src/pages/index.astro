---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PartnerMarquee from '../components/PartnerMarquee.astro';
import ServiceCard from '../components/ServiceCard.astro';
import NewsCard from '../components/NewsCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { portals } from '../data/portals';
import { serviceImage } from '../data/cardImages';
import { t } from '../i18n/fr';

const services = await getCollection('services');
const featured = services.filter((service) => service.data.featured).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).slice(0, 6);
const particulier = services.filter((service) => service.data.audience === 'particulier').sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const professionnel = services.filter((service) => service.data.audience === 'professionnel').sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<BaseLayout title={t.site.name} description={t.site.description} bodyClass="home-organic">
  <div class="page-shell page-shell--home">
    <Hero />

    <section class="home-intro" data-reveal>
      <div class="home-intro__image"><img src="/images/photos/particulier-famille-protection-assurance-familiale.jpg" alt="" width="1200" height="800" /></div>
      <div class="home-intro__copy">
        <p class="organic-kicker">BDT Sironval</p>
        <h2>Un service à votre écoute, au-delà de la souscription.</h2>
        <p>Nous comparons les contrats, expliquons leurs limites et restons votre interlocuteur lorsque votre situation change ou qu’un sinistre survient.</p>
        <ul>
          <li>Un conseiller qui connaît votre dossier</li>
          <li>Des garanties comparées avant le prix</li>
          <li>Un suivi direct avec les compagnies</li>
        </ul>
        <a href="/contact" class="organic-button organic-button--moss">Découvrir le bureau</a>
      </div>
    </section>

    <section class="home-services" aria-labelledby="home-services-title" data-reveal>
      <header class="organic-section-heading">
        <div><p class="organic-kicker">Particulier et professionnel</p><h2 id="home-services-title">Les protections que nous comparons pour vous</h2></div>
        <p>Chaque dossier commence par votre situation réelle : ce qui doit être couvert, ce qui peut rester à votre charge et ce qui mérite d’être expliqué.</p>
      </header>
      <div class="organic-card-grid">{featured.map((service) => <ServiceCard title={service.data.title} summary={service.data.summary} href={`/${service.id}`} image={service.data.heroImage ?? serviceImage(service.id)} />)}</div>
    </section>

    <section class="audience-panels" aria-label="Assurances par public" data-reveal>
      <article>
        <p class="organic-kicker">Particuliers</p>
        <h2>Protéger le quotidien et préparer la suite.</h2>
        <ul>{particulier.slice(0, 8).map((service) => <li><a href={`/${service.id}`}><span>{service.data.title}</span><small>Voir</small></a></li>)}</ul>
      </article>
      <article>
        <p class="organic-kicker">Professionnels</p>
        <h2>Couvrir l’activité, les équipes et les revenus.</h2>
        <ul>{professionnel.slice(0, 8).map((service) => <li><a href={`/${service.id}`}><span>{service.data.title}</span><small>Voir</small></a></li>)}</ul>
      </article>
    </section>

    <section class="document-feature" aria-labelledby="document-feature-title" data-reveal>
      <div>
        <p class="organic-kicker">Bibliothèque produit</p>
        <h2 id="document-feature-title">2 957 documents d’assurance, reliés à leur source.</h2>
        <p>Conditions générales, fiches IPID, informations commerciales et documents fiscaux issus du catalogue sectoriel et ouverts sur le site de la compagnie.</p>
        <a href="/documents" class="organic-button organic-button--sand">Rechercher un document</a>
      </div>
      <div class="document-feature__list">
        <span>Recherche plein texte</span><span>Filtre par compagnie</span><span>Filtre par domaine</span><span>PDF source</span>
      </div>
    </section>

    <section class="portal-home" aria-labelledby="portal-home-title" data-reveal>
      <header><p class="organic-kicker">Vos espaces sécurisés</p><h2 id="portal-home-title">Accéder à vos contrats personnels</h2></header>
      <div>{portals.map((portal) => <a href={portal.url} target="_blank" rel="noopener noreferrer"><span>{portal.label}</span><h3>{portal.name}</h3><p>{portal.description}</p><strong class="organic-text-link">Se connecter</strong></a>)}</div>
    </section>

    <section class="home-news" aria-labelledby="home-news-title" data-reveal>
      <header class="organic-section-heading"><div><p class="organic-kicker">Infos pratiques</p><h2 id="home-news-title">Nos actualités</h2></div><a href="/actualites" class="organic-button organic-button--moss">Toutes les actualités</a></header>
      <div class="organic-card-grid">{news.map((article) => <NewsCard title={article.data.title} summary={article.data.summary} date={article.data.date} tags={article.data.tags} image={article.data.image} href={`/actualites/${article.id}`} />)}</div>
    </section>

    <PartnerMarquee />
  </div>
  <ContactCTA />
</BaseLayout>
