---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

interface Props { title: string; description: string; eyebrow?: string; }
const { title, description, eyebrow = 'Informations' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="page-shell">
    <PageHero title={title} description={description} eyebrow={eyebrow} compact />
    <div class="simple-page"><div class="prose-service"><slot /></div></div>
  </div>
</BaseLayout>
