---
import type { CollectionEntry } from 'astro:content';
import { render, getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { serviceImage } from '../data/cardImages';

interface Props { service: CollectionEntry<'services'>; }

const { service } = Astro.props;
const { Content } = await render(service);
const related = (await getCollection('services'))
  .filter((s) => s.id !== service.id && s.data.audience === service.data.audience && s.data.category === service.data.category)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);
const audienceLabel = service.data.audience === 'particulier' ? 'Particulier' : 'Professionnel';
const image = service.data.heroImage ?? serviceImage(service.id);
---

<BaseLayout title={service.data.title} description={service.data.summary}>
  <div class="page-shell">
    <nav aria-label="Fil d’Ariane" class="organic-breadcrumb">
      <a href="/">Accueil</a><span>/</span><span>{audienceLabel}</span><span>/</span><span aria-current="page">{service.data.title}</span>
    </nav>
    <PageHero eyebrow={audienceLabel} title={service.data.title} description={service.data.summary} image={image}>
      <div class="organic-actions">
        <a href="/devis" class="organic-button organic-button--clay">Demander un devis</a>
        <a href="/contact" class="organic-button organic-button--sand">Poser une question</a>
      </div>
    </PageHero>

    <div class="service-body">
      <article class="prose-service"><Content /></article>
      <aside class="service-aside">
        <div class="service-aside__card">
          <p class="organic-kicker">Votre courtier</p>
          <h2>Comparer avant de choisir</h2>
          <p>Nous examinons les garanties, exclusions et tarifs des compagnies partenaires pour votre situation.</p>
          <a href="/contact" class="organic-text-link">Nous contacter</a>
        </div>
        <div class="service-aside__card service-aside__card--clay">
          <p class="organic-kicker">Contrat existant</p>
          <h2>Un sinistre à déclarer ?</h2>
          <p>Transmettez les premières informations en ligne. Nous reprenons ensuite le dossier avec la compagnie.</p>
          <a href="/declaration" class="organic-text-link">Déclarer le sinistre</a>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related-section">
        <p class="organic-kicker">Dans la même catégorie</p>
        <h2>À découvrir aussi</h2>
        <div class="organic-card-grid">
          {related.map((s) => <ServiceCard title={s.data.title} summary={s.data.summary} href={`/${s.id.replace(/\.md$/, '')}`} image={s.data.heroImage ?? serviceImage(s.id)} />)}
        </div>
      </section>
    )}
  </div>
  <ContactCTA />
</BaseLayout>
