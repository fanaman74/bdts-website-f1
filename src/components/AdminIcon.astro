---
interface Props {
  name: 'dashboard' | 'messages' | 'declarations' | 'users' | 'signout';
}

const { name } = Astro.props;

const PATHS: Record<string, string> = {
  dashboard: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  messages: 'M4 5h16v11H8l-4 4z',
  declarations: 'M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h4',
  users: 'M16 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1M9.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M21 20v-1a4 4 0 0 0-3-3.87M16 4.13A4 4 0 0 1 16 11.9',
  signout: 'M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 8l-4 4 4 4M6 12h9'
};

const d = PATHS[name] ?? PATHS.dashboard;
---

<svg
  class="h-5 w-5"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
