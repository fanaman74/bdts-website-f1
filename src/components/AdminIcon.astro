---
interface Props {
  name: 'dashboard' | 'messages' | 'signout';
}

const { name } = Astro.props;

const PATHS: Record<string, string> = {
  dashboard: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  messages: 'M4 5h16v11H8l-4 4z',
  signout: 'M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 8l-4 4 4 4M6 12h9'
};

const d = PATHS[name] ?? PATHS.dashboard;
---

<svg
  class="h-5 w-5"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
