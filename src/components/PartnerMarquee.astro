---
const partners = [
  'AG Insurance',
  'AXA',
  'Baloise',
  'Allianz',
  'DKV',
  'NN',
  'Vivium',
  'Ethias',
  'ARAG',
  'Europ Assistance'
];
---

<section class="swiss-partners" aria-labelledby="partners-title">
  <div class="swiss-frame swiss-partners-grid">
    <p id="partners-title">Compagnies partenaires</p>
    <ul>
      {partners.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>
