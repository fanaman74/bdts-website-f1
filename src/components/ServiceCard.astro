---
interface Props {
  title: string;
  summary: string;
  href: string;
  icon?: string;
  image?: string;
  accent?: 'pulse' | 'coral' | 'mint';
}

const { title, summary, href, image } = Astro.props;
---

<a href={href} class="organic-service-card group">
  {
    image && (
      <div class="organic-service-card__image">
        <img
          src={image}
          alt=""
          width="900"
          height="600"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.035]"
        />
      </div>
    )
  }
  <div class="organic-service-card__body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="organic-text-link">
      Découvrir
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
      </svg>
    </span>
  </div>
</a>
