---
import { workflowSteps, type ResponseDraft } from '../lib/responseDrafts';

interface Props {
  draft: ResponseDraft;
  documents: Array<{ id: string; title: string; href?: string }>;
  selectedIds?: string[];
  usedIds?: string[];
  generationError?: string;
  notice?: string;
  recordType: 'inquiry' | 'declaration';
  customerEmail?: string | null;
  workflowKind?: string;
}
const { draft, documents, selectedIds = draft.sourceDocumentIds, usedIds = draft.sourceDocumentIds, generationError, notice, recordType, customerEmail = '', workflowKind = recordType } = Astro.props;
const subjectId = `draft-subject-${recordType}`;
const bodyId = `draft-body-${recordType}`;
---

<section class="mt-8 rounded-2xl border border-[#3b3020] bg-[#15130f] p-5 shadow-[0_18px_50px_rgba(0,0,0,.2)]" aria-labelledby={`draft-title-${recordType}`}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-[10px] uppercase tracking-[.18em] text-[#b28a48]">Réponse préparée</p>
      <h2 id={`draft-title-${recordType}`} class="mt-1 text-xl font-semibold text-[#f2efe8]">Brouillon à relire</h2>
      <p class="mt-1 max-w-2xl text-xs leading-5 text-[#9b9488]">Le modèle est disponible immédiatement. La génération assistée reste volontaire et aucun e-mail n’est envoyé depuis cette page.</p>
      <ul class="mt-3 flex flex-wrap gap-2" aria-label="Prochaines étapes">
        {workflowSteps(workflowKind).map((step, index) => <li class="rounded-full border border-[#46381f] bg-[#1d170c] px-2.5 py-1 text-[11px] text-[#c9a560]">{index + 1}. {step}</li>)}
      </ul>
    </div>
    {draft.updatedAt && <time class="text-[11px] text-[#756e62]" datetime={draft.updatedAt}>Enregistré {new Date(draft.updatedAt).toLocaleString('fr-BE')}</time>}
  </div>

  {notice && <p class="mt-4 rounded-lg border border-[#2b5c40] bg-[#12241a] px-3 py-2 text-xs text-[#8fd0a8]">{notice}</p>}
  {generationError && <p class="mt-4 rounded-lg border border-[#5e2f28] bg-[#2a1614] px-3 py-2 text-xs text-[#e08b7c]">{generationError}</p>}

  <form method="post" class="mt-5 space-y-4">
    <label class="block text-xs text-[#aaa49a]" for={subjectId}>Objet
      <input id={subjectId} name="subject" value={draft.subject} maxlength="300" required class="mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#101211] px-3 py-2 text-sm text-[#eeeae1] focus:border-[#d4a24c] focus:outline-none" />
    </label>
    <label class="block text-xs text-[#aaa49a]" for={bodyId}>Message
      <textarea id={bodyId} name="body" rows="12" maxlength="20000" required class="mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#101211] px-3 py-2 text-sm leading-6 text-[#eeeae1] focus:border-[#d4a24c] focus:outline-none">{draft.body}</textarea>
    </label>
    <div>
      <p class="text-xs text-[#aaa49a]">Sources pour la génération (maximum 3)</p>
      <input id={`doc-search-${recordType}`} type="search" placeholder="Rechercher un document…" class="mt-1 w-full rounded-lg border border-[#2a2f2d] bg-[#101211] px-3 py-2 text-xs text-[#eeeae1] placeholder:text-[#756e62] focus:border-[#d4a24c] focus:outline-none" />
      <div id={`doc-list-${recordType}`} class="mt-2 grid max-h-48 gap-1 overflow-auto rounded-lg border border-[#262a28] p-2 sm:grid-cols-2">
        {documents.map((document) => (
          <label data-document-option={document.title.toLowerCase()} class="flex items-start gap-2 rounded-md px-2 py-1.5 text-xs text-[#c8c6c0] hover:bg-[#201c15]">
            <input type="checkbox" name="sourceDocumentIds" value={document.id} checked={selectedIds.includes(document.id)} class="mt-0.5 accent-[#d4a24c]" />
            <span>{document.href ? <a href={document.href} target="_blank" rel="noreferrer" class="hover:text-[#e0b568] hover:underline">{document.title}</a> : document.title}</span>
          </label>
        ))}
      </div>
      {usedIds.length > 0 && <div class="mt-3 rounded-lg border border-[#2b5c40] bg-[#12241a] px-3 py-2 text-[11px] text-[#8fd0a8]"><p class="mb-1 uppercase tracking-[.12em]">Sources réellement utilisées</p>{usedIds.map((id) => { const document = documents.find((entry) => entry.id === id); return document?.href ? <a href={document.href} target="_blank" rel="noreferrer" class="mr-2 inline-block hover:underline">{document.title} ↗</a> : document?.title ?? id; })}</div>}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <input type="hidden" name="sourceUsedIds" value={draft.sourceDocumentIds.join(',')} />
      <button type="submit" name="action" value="save-draft" class="rounded-lg bg-[#d4a24c] px-4 py-2 text-xs font-semibold text-[#1b1509] transition-colors hover:bg-[#e0b568]">Enregistrer le brouillon</button>
      <button type="submit" name="action" value="generate" class="rounded-lg border border-[#80602b] px-4 py-2 text-xs text-[#e0b568] transition-colors hover:bg-[#241a0d]">Générer avec les sources sélectionnées</button>
      {customerEmail ? <a data-draft-mailto data-email={customerEmail} href={`mailto:${customerEmail}?subject=${encodeURIComponent(draft.subject)}&body=${encodeURIComponent(draft.body)}`} class="rounded-lg border border-[#2a2f2d] px-4 py-2 text-xs text-[#aaa49a] hover:text-[#f2efe8]">Ouvrir dans la messagerie</a> : <span class="rounded-lg border border-[#2a2f2d] px-4 py-2 text-xs text-[#756e62]">E-mail client indisponible</span>}
    </div>
  </form>
</section>

<script is:inline define:vars={{ recordType }}>
  const search = document.querySelector(`#doc-search-${recordType}`);
  const options = [...document.querySelectorAll(`[data-document-option]`)];
  search?.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    options.forEach((option) => { option.classList.toggle('hidden', !option.dataset.documentOption?.includes(query)); });
  });
  const mailto = document.querySelector('[data-draft-mailto]');
  const subject = document.querySelector(`#${'draft-subject-' + recordType}`);
  const body = document.querySelector(`#${'draft-body-' + recordType}`);
  const updateMailto = () => { if (mailto && subject && body) mailto.setAttribute('href', `mailto:${mailto.dataset.email || ''}?subject=${encodeURIComponent(subject.value)}&body=${encodeURIComponent(body.value)}`); };
  subject?.addEventListener('input', updateMailto);
  body?.addEventListener('input', updateMailto);
</script>
