---
interface Props { title?: string; body?: string; }
const {
  title = 'Parlons de votre situation',
  body = "Un conseil, un devis ou une question sur un contrat existant ? Notre équipe vous répond par téléphone, e-mail ou au bureau."
} = Astro.props;
---

<section class="contact-cta">
  <div>
    <p class="organic-kicker">BDT Sironval</p>
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
  <div class="organic-actions">
    <a href="/contact" class="organic-button organic-button--sand">Nous contacter</a>
    <a href="tel:+3224631925" class="organic-button organic-button--clay">+32 2 463 19 25</a>
  </div>
</section>
