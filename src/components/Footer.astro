---
import { mainNav, topNav } from '../data/navigation';
import { t } from '../i18n/fr';

const year = new Date().getFullYear();
const legalLinks = [
  { label: 'Mentions légales', href: '/mentions-legales' },
  { label: 'Vie privée', href: '/vie-privee' },
  { label: 'Cookies', href: '/cookies' },
  { label: 'Durabilité', href: '/durabilite' },
  { label: 'Protection du client', href: '/protection-du-client' }
];

const navSections = mainNav
  .filter((s) => s.slug !== 'autres')
  .map((section) => ({ label: section.label, links: section.groups.map((group) => ({ label: group.label, href: group.items[0]!.href })) }));
const pratique = {
  label: 'Pratique',
  links: [...topNav, { label: 'Contact', href: '/contact' }, { label: 'Sinistre', href: '/declaration' }]
};
// Pratique sits right after Particulier so all columns share one row.
const footerSections = [navSections[0]!, pratique, ...navSections.slice(1)];
---

<footer class="site-footer">
  <div class="site-footer__shell">
    <div class="site-footer__lead">
      <div class="site-footer__brand">
        <img src="/images/logo-bdts.png" alt="" width="222" height="246" />
        <div><strong>BDT Sironval</strong><span>Courtiers en assurances à Bruxelles</span></div>
      </div>
      <p>{t.site.tagline}</p>
      <a href="/contact" class="organic-button organic-button--sand">Prendre contact</a>
    </div>

    <div class="site-footer__columns">
      <div>
        <h2>Bureau de Bruxelles</h2>
        <address>
          Rue de Wand 29<br />1020 Bruxelles<br />
          <a href="tel:+3224631925">+32 2 463 19 25</a><br />
          <a href="mailto:bdts@bdts.be">bdts@bdts.be</a>
        </address>
      </div>
      {footerSections.map((section) => (
        <nav aria-label={`Liens ${section.label}`}>
          <h2>{section.label}</h2>
          <ul>{section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>

    <div class="site-footer__legal">
      <div><p>{t.footer.fsma}</p><p>{t.footer.disclaimer}</p></div>
      <div><p>© {year} {t.site.name}</p><ul>{legalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>
    </div>
  </div>
</footer>
