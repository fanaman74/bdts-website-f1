---
import { portals } from '../data/portals';
import { t } from '../i18n/fr';
---

<section id="portails" class="portal-panel">
  <div class="portal-panel__intro">
    <p class="organic-kicker">{t.nav.clientZone}</p>
    <h2>{t.documents.portalPanelTitle}</h2>
    <p>{t.documents.portalPanelBody}</p>
  </div>
  <div class="portal-panel__grid">
    {portals.map((portal) => (
      <a href={portal.url} target="_blank" rel="noopener noreferrer" class="portal-card">
        <span>{portal.label}</span>
        <h3>{portal.name}</h3>
        <p>{portal.description}</p>
        <ul>{portal.features.map((feature) => <li>{feature}</li>)}</ul>
        <strong class="organic-text-link">Se connecter</strong>
      </a>
    ))}
  </div>
</section>
