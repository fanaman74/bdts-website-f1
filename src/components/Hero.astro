---
import { t } from '../i18n/fr';

const quickActions = [
  { label: 'Demander un devis', href: '/devis' },
  { label: 'Déclarer un sinistre', href: '/declaration' },
  { label: 'Trouver un document', href: '/documents' },
  { label: 'Prendre contact', href: '/contact' }
];
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy">
    <p class="organic-kicker">Courtier indépendant · Bruxelles</p>
    <h1 id="home-title">Des assurances,<br /><em>en toute sérénité.</em></h1>
    <p class="home-hero__lede">{t.hero.subheadline}</p>
    <div class="organic-actions">
      <a href="/contact" class="organic-button organic-button--clay">Parler à un conseiller</a>
      <a href="tel:+3224631925" class="organic-button organic-button--sand">+32 2 463 19 25</a>
    </div>
  </div>

  <figure class="home-hero__media">
    <img src="/images/photos/professionnel-entreprise-responsabilite.jpg" alt="" width="1600" height="1067" fetchpriority="high" />
    <figcaption class="home-hero__office">
      <div><strong>Rue de Wand 29</strong><span>1020 Bruxelles</span></div>
      <a href="tel:+3224631925"><strong>+32 2 463 19 25</strong><span>Du lundi au vendredi</span></a>
      <a href="mailto:bdts@bdts.be"><strong>bdts@bdts.be</strong><span>Écrivez-nous</span></a>
    </figcaption>
  </figure>
</section>

<nav class="home-tasks" aria-label="Vos démarches">
  {quickActions.map((action, index) => (
    <a href={action.href}>
      <small aria-hidden="true">0{index + 1}</small>
      <span>{action.label}</span>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10h11m-4-4.5L15.5 10 11 14.5" /></svg>
    </a>
  ))}
</nav>
