---
import { t } from '../i18n/fr';
---

<section class="swiss-hero" aria-labelledby="home-title">
  <div class="swiss-frame swiss-hero-grid">
    <div class="swiss-hero-copy">
      <div class="swiss-meta-line">
        <span>BDT Sironval</span>
        <span>Courtier indépendant à Bruxelles</span>
      </div>

      <h1 id="home-title">
        Le bon contrat<br />commence par<br /><span>la bonne question.</span>
      </h1>

      <p class="swiss-hero-intro">{t.hero.subheadline}</p>

      <div class="swiss-actions" aria-label="Actions principales">
        <a href="/devis" class="swiss-action swiss-action-primary">{t.hero.ctaQuote}</a>
        <a href="/declaration" class="swiss-action">{t.hero.ctaClaim}</a>
      </div>
    </div>

    <div class="swiss-hero-media">
      <video
        class="swiss-office-film"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/hero-poster.jpg"
        tabindex="-1"
      >
        <source src="/videos/hero-office.mp4" type="video/mp4" />
      </video>
      <div class="swiss-film-index" aria-hidden="true">01</div>
      <div class="swiss-film-caption">
        <span>Rue de Wand 29</span>
        <span>1020 Bruxelles</span>
      </div>
    </div>
  </div>

  <script>
    const heroVideo = document.querySelector<HTMLVideoElement>('.swiss-office-film');
    if (heroVideo && matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroVideo.removeAttribute('autoplay');
      heroVideo.pause();
    }
  </script>

  <div class="swiss-contact-rail">
    <div class="swiss-frame">
      <a href="tel:+3224631925">+32 2 463 19 25</a>
      <a href="mailto:bdts@bdts.be">bdts@bdts.be</a>
      <a href="/documents">Documents produits</a>
      <a href="/contact">Prendre contact</a>
    </div>
  </div>
</section>
