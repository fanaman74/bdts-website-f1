---
import { t } from '../i18n/fr';

const quickActions = [
  { label: 'Demander un devis', href: '/devis' },
  { label: 'Déclarer un sinistre', href: '/declaration' },
  { label: 'Trouver un document', href: '/documents' },
  { label: 'Prendre contact', href: '/contact' }
];
---

<section class="home-hero" aria-labelledby="home-title">
  <img class="home-hero__image" src="/images/photos/professionnel-entreprise-responsabilite.jpg" alt="" width="1600" height="1067" fetchpriority="high" />
  <div class="home-hero__veil" aria-hidden="true"></div>
  <div class="home-hero__copy">
    <p class="organic-kicker">Courtier indépendant · Bruxelles</p>
    <h1 id="home-title">Vos assurances,<br />expliquées avant<br />d’être signées.</h1>
    <p>{t.hero.subheadline}</p>
    <a href="/contact" class="organic-button organic-button--clay">Parler à un conseiller</a>
  </div>
  <nav class="home-hero__paths" aria-label="Vos démarches">
    {quickActions.map((action) => <a href={action.href}><span aria-hidden="true"></span>{action.label}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></a>)}
  </nav>
</section>

<div class="home-contact-strip">
  <div><strong>Rue de Wand 29</strong><span>1020 Bruxelles</span></div>
  <a href="tel:+3224631925"><strong>+32 2 463 19 25</strong><span>Du lundi au vendredi</span></a>
  <a href="mailto:bdts@bdts.be"><strong>bdts@bdts.be</strong><span>Écrivez-nous</span></a>
</div>
