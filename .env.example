# Server-only Supabase settings. Never expose the secret key through PUBLIC_*.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Document assistant (OpenRouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Site-wide cap on document assistant questions per 24 hours (default 500).
DOCUMENT_CHAT_DAILY_LIMIT=500

# Email notification for contact, quote and claim forms (Resend).
RESEND_API_KEY=
# Comma-separated recipients, e.g. bdts@bdts.be
INQUIRY_NOTIFY_TO=
# Sender on a domain verified in Resend, e.g. BDTS Website <site@bdts.be>
INQUIRY_NOTIFY_FROM=
