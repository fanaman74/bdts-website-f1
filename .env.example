# Server-only Neon Postgres connection string. Never expose it through PUBLIC_*.
# Neon Console → your project → Connect → "Connection string" (pooled host recommended).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Required for the PDF assistant on /documents.
OPENROUTER_API_KEY=replace_me

# Optional. Leave it unset to let OpenRouter choose a free model
# (openrouter/free), with qwen/qwen3.8-27b:free as the fallback. Set it to pin
# one specific model. Never point it at a paid model while the account's
# "Allowed Models" list restricts access to the free router.
# OPENROUTER_MODEL=openrouter/free

