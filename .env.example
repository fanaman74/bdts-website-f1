# Server-only Neon Postgres connection string. Never expose it through PUBLIC_*.
# Neon Console → your project → Connect → "Connection string" (pooled host recommended).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Document assistant. The provider and model are chosen in the admin area
# (/admin); only the API keys belong here. DeepSeek is the default provider.
DEEPSEEK_API_KEY=replace_me

# Transactional email, used for account verification.
# Resend: create the key under API Keys, and verify your sending domain first.
# Once the domain is verified, ANY address at it can send — no per-sender setup.
# EMAIL_FROM must be on that verified domain or Resend rejects the send.
RESEND_API_KEY=replace_me
EMAIL_FROM="BDT Sironval <hello@your-domain.be>"

# Alternative provider. Only set one; if several keys are present, set
# EMAIL_PROVIDER to say which wins, otherwise the first match is used silently.
# BREVO_API_KEY=replace_me
# EMAIL_PROVIDER=resend

# Optional. Set to "console" to print emails (including verification links) to
# the server log instead of sending them — useful locally. Never in production:
# real users would never receive their link.
# EMAIL_PROVIDER=console

# Admin area. Accounts live in the database — create them with:
#   npm run admin:user -- --email you@example.com --role admin --password "…"
# The only admin setting that belongs here is the secret that signs session cookies.
ADMIN_SESSION_SECRET=replace_me

