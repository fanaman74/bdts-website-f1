# Server-only Neon Postgres connection string. Never expose it through PUBLIC_*.
# Neon Console → your project → Connect → "Connection string" (pooled host recommended).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Required for the PDF assistant on /documents. Routera key (rta_...), created
# under Account > API Keys at https://www.routera.one
ROUTERA_API_KEY=replace_me

# Optional. Defaults to openai/gpt-5.6-luna, then qwen/qwen3.5-27b. Set it to pin
# one model. Routera grants model access per plan and bills per token, so check
# GET https://api.routera.one/v1/models for current prices.
# ROUTERA_MODEL=openai/gpt-5.6-luna

